package render

import (
	"slices"
	"strconv"

	"github.com/Olian04/webui/internal/ir"
	t "github.com/Olian04/webui/internal/render/templates"
	c "github.com/Olian04/webui/internal/render/templates/components"
)

// Document is the shell around one page's content.
templ (r *Renderer) Document(d Doc) {
	@t.Page(t.PageProps{
		Title:       r.title(d.Title),
		Early:       r.early(),
		Stylesheets: r.styles(),
		Scripts:     r.scripts(d),
		Head:        r.head(d.Code),
		Sidebar:     r.sidebar(d.Home, d.Active, d.HideNav, d.NavLinks),
		TopBar:      r.topbar(d.Crumbs, d.URL),
		Status:      r.statusBar(d, c.StatusBar),
		Toasts:      toastRegion(d.Toasts),
		Streaming:   d.Streaming,
		StatusLive:  r.statusBar(d, c.StatusBarLive),
		StatusLate:  r.statusBar(d, c.StatusBarLate),
	}) {
		if d.Content != nil {
			@d.Content
		}
	}
}

// early tells the browser the page's background before it has the stylesheet, so
// the first paint of a navigation is the dark or light canvas and not its default
// white, which flashed in dark mode. The colour scheme follows the system, as the
// stylesheet does, and a stored choice (the theme switch) is the attribute that
// prefs.js sets before first paint.
templ (r *Renderer) early() {
	<meta name="color-scheme" content="dark light"/>
	@templ.Raw("<style>" + earlyCSS + "</style>")
}

// head carries the one script that must run before first paint, so the stored
// theme never flashes. It is a classic script, because modules are deferred.
templ (r *Renderer) head(needs CodeNeeds) {
	<script src={ r.AssetHref("prefs.js") }></script>
	@r.favicons()
	if needs.Used {
		@r.codeHead(needs)
	}
}

// codeHead links the editor on a page that has one: its stylesheet, what its script is
// told, and the script, a module, which mounts Monaco over the textareas and the
// plain text that are already on the page.
templ (r *Renderer) codeHead(needs CodeNeeds) {
	{{ code := r.code(needs) }}
	<link rel="stylesheet" href={ code.Style }/>
	@templ.JSONScript("webui-code", code.Config)
	<script type="module" src={ code.Entry }></script>
}

// favicons links the browser tab's icon: the logo scaled to each size, with the
// largest also the one a phone puts on its home screen, or the library's mark
// when the app has no logo. An app that turned it off declares its own.
templ (r *Renderer) favicons() {
	if r.app.Brand.DefaultFavicon {
		<link rel="icon" type="image/svg+xml" href={ r.AssetHref("favicon.svg") }/>
	}
	for i, f := range r.app.Brand.Favicons {
		if i == len(r.app.Brand.Favicons)-1 {
			<link rel="apple-touch-icon" sizes={ sizes(f.Size) } href={ r.AssetHref(faviconName(f.Size)) }/>
		} else {
			<link rel="icon" type="image/png" sizes={ sizes(f.Size) } href={ r.AssetHref(faviconName(f.Size)) }/>
		}
	}
}

func sizes(n int) string { return strconv.Itoa(n) + "x" + strconv.Itoa(n) }

// sidebar lists the entries the visitor may open, grouped by section. A section's
// caption appears above its first entry that is shown, so a section with nothing
// left in it has no caption either.
templ (r *Renderer) sidebar(home, active string, hide map[string]bool, links map[string][]NavLink) {
	@c.Sidebar(c.SidebarProps{Brand: r.brand(), Logo: r.logoHref(), Home: home, Footer: r.sidebarFooter()}) {
		for _, e := range r.shown(hide, links) {
			if e.Section != "" {
				@c.NavSection(e.Section)
			}
			@c.NavItem(c.NavItemProps{Label: e.Label, Href: e.Href, Active: e.lit(active), Icon: c.IconName(e.Icon), Letter: initial(e.Label)})
		}
	}
}

// topbar holds the breadcrumb and, on the right, the page search, Refresh, and the
// menu when the app declares one.
// The search is only there when some page has a Search, since it is only the results of those: an app with none has no search box.
// It is wrapped so it is simply absent without script rather than present and inert. Refresh is a link to the address the browser is on, so it
// reloads the page, state in the address and all, with or without script.
templ (r *Renderer) topbar(crumbs []c.Crumb, here string) {
	@c.TopBar(c.TopBarProps{Crumbs: crumbs}) {
		if r.search {
			<div class="js-only">
				@c.Search(c.SearchProps{Placeholder: "Search…", Shortcut: "⌘K", Attrs: r.searchAttrs()})
			</div>
		}
		@c.IconButton(c.IconButtonProps{
			Icon: c.IconRefresh, Title: "Refresh", Href: here,
			Attrs: templ.Attributes{"data-refresh": true},
		})
		if items := r.linkEntries(); len(items) > 0 {
			@c.ExternalLinks(items)
		}
		if r.search {
			<div class="palette" id="palette" role="listbox" aria-label="Search results" data-palette></div>
		}
	}
}

// sidebarFooter holds the one session switch there is. It needs script, so it
// is absent without it; the stored choice is a browser preference, never an
// argument, which is why it does not touch the URL.
templ (r *Renderer) sidebarFooter() {
	<div class="js-only">
		@c.SidebarFooter() {
			@c.SidebarCollapse()
			@c.SidebarRow("Light theme") {
				@c.Switch(c.SwitchProps{
					ID: "pref-theme", Label: "Light theme", 
					Attrs: templ.Attributes{"data-pref": "theme"},
				})
			}
		}
	</div>
}

// searchAttrs describes the search box to the page script: a listbox it fills, and where to ask for the results of the pages
// that offer Search.
func (r *Renderer) searchAttrs() templ.Attributes {
	return templ.Attributes{
		"role": "combobox", "aria-expanded": "false", "aria-controls": "palette",
		"aria-autocomplete": "list", "data-search-url": r.AssetHref("search"),
	}
}

func (r *Renderer) logoHref() string {
	if !r.hasLogo() {
		return ""
	}
	return r.AssetHref("logo")
}

templ toastRegion(toasts []Toast) {
	@c.ToastRegion() {
		for i, x := range toasts {
			@c.Toast(c.ToastProps{Tone: x.Tone, Title: x.Title, Desc: x.Desc, Name: "toast-" + strconv.Itoa(i)})
		}
	}
}


// CompileFailure replaces the whole application: no sidebar, no navigation,
// every problem at once. It is served at every address until the app compiles.
templ CompileFailure(problems []Problem) {
	@t.Document(t.DocumentProps{
		Title: "Failed to compile — webui",
		Head:  failureHead(),
	}) {
		@c.CompileError(c.CompileErrorProps{Problems: problems})
	}
}

// Stack arranges children in a column, 8px apart.
templ Stack(children []templ.Component) {
	@c.Stack() {
		@templ.Join(children...)
	}
}

// Split arranges children side by side; those in a row are as tall as the tallest of them.
templ Split(children []templ.Component) {
	@c.Split() {
		@templ.Join(children...)
	}
}

// Table renders a loaded table leaf as one panel: header, rows, and a pager
// footer when the table has an offset argument. A table with actions is one
// form, so a button anywhere in it posts the selection with it.
templ (r *Renderer) Table(v TableView) {
	{{ cols := r.columns(v) }}
	@c.Panel(c.PanelProps{
		Title:  v.Node.Title,
		Desc:   v.Node.Desc,
		Failed: v.Failed, Refused: refusedOf(v.Refusal),
		Leaf:   LeafID(v.Node.At),
		Grows:  true,
		Footer: r.tableFooter(v),
	}) {
		if v.interactive() {
			@c.Form(c.FormProps{Action: r.PageHref(v.Page, v.Path, v.Query)}) {
				<input type="hidden" name="_leaf" value={ LeafID(v.Node.At) }/>
				@r.tableContent(v, cols)
			}
		} else {
			@r.tableContent(v, cols)
		}
	}
}

templ (r *Renderer) tableContent(v TableView, cols []columnView) {
	if v.selectable() {
		@c.ActionBar() {
			for i, a := range v.Node.Bulk {
				@c.Button(c.ButtonProps{Variant: variant(a.Role), Size: c.SizeSmall, Name: "_act", Value: BulkActionValue(i), Confirm: a.Confirm, ConfirmID: confirmID(v.Node.At, "b", i)}) {
					{ a.Label }
				}
			}
		}
	}
	@c.Table(c.TableProps{Label: v.label()}) {
		<colgroup>
			if v.selectable() {
				<col class="pick"/>
			}
			for _, w := range columnWidths(cols) {
				<col style={ "width:" + w }/>
			}
			if v.hasRowActions() {
				<col class="actions"/>
			}
		</colgroup>
		@c.TableHead() {
			if v.selectable() {
				@c.SelectAllColumn()
			}
			for _, col := range cols {
				@c.Column(c.ColumnProps{Label: col.Field.Label, Align: col.Align, SortHref: col.SortHref, SortDir: col.SortDir, Filter: col.Filter})
			}
			if v.hasRowActions() {
				<th class="actions"><span class="sr-only">Actions</span></th>
			}
		}
		@c.TableBody() {
			if len(v.Rows) == 0 {
				@c.Row(c.RowProps{}) {
					@c.Cell(c.CellProps{ColSpan: v.width()}) {
						@c.EmptyState(c.EmptyStateProps{
							Icon:  c.IconSearch,
							Title: "Nothing to show",
							Desc:  emptyHint(v),
						})
					}
				}
			}
			for i, row := range v.Rows {
				@r.tableRow(v, cols, i, row)
			}
		}
	}
}

func emptyHint(v TableView) string {
	if v.Q.Offset > 0 {
		return "This page is past the end. Go back to the first page."
	}
	return "No rows were returned for the current arguments."
}

func (r *Renderer) tableFooter(v TableView) templ.Component {
	if v.Failed {
		return nil
	}
	if v.Node.Feed {
		first, prev, next := r.feedLinks(v)
		return c.CursorPager(c.CursorPagerProps{Rows: len(v.Rows), Start: v.Q.Start, FirstHref: first, PrevHref: prev, NextHref: next, Sorted: v.Q.Sort != "", Export: r.exportLinks(v)})
	}
	return c.Pager(r.pager(v))
}

templ (r *Renderer) tableRow(v TableView, cols []columnView, i int, row any) {
	@c.Row(c.RowProps{Href: v.Hrefs[i], Clickable: v.clicks(i)}) {
		if v.selectable() {
			@c.SelectCell(c.SelectCellProps{Name: "_sel", Value: v.Keys[i], Label: "Select row " + v.Keys[i]})
		}
		for j, col := range cols {
			@r.cell(col, row, v.Hrefs[i], v.clicks(i), v.rowClickValue(i), j == 0)
		}
		if v.hasRowActions() {
			<td class="actions">
				for a, act := range v.Node.Actions {
					@c.Button(c.ButtonProps{
						Variant: variant(act.Role), Size: c.SizeSmall,
						Name: "_act", Value: RowActionValue(a, v.Keys[i]), Guard: v.gate(i, a),
						Confirm: act.Confirm, ConfirmID: confirmID(v.Node.At, "r"+strconv.Itoa(i)+"a", a),
					}) {
						{ act.Label }
					}
				}
			</td>
		}
	}
}

// cell is one value. The row's single anchor lives in the first cell, because
// the stylesheet stretches it over every other.
templ (r *Renderer) cell(col columnView, row any, href string, button bool, click string, first bool) {
	@c.Cell(c.CellProps{Align: col.Align}) {
		if first && href != "" {
			@c.RowLink(href) {
				@value(col.Field, col.Field.Shown(ctx, row), row)
			}
		} else if first && button {
			@c.RowButton("_act", click) {
				@value(col.Field, col.Field.Shown(ctx, row), row)
			}
		} else {
			@value(col.Field, col.Field.Shown(ctx, row), row)
		}
	}
}

// value is a field's value as the field says to show it: text, a badge, or a
// bar. A table cell and a read-only form field show it the same way. text is what is
// shown, and model what a link or a <time> element holds, which the text may not be.
templ value(f ir.Field, text string, model any) {
	if f.Nullable && text == "" {
		@dash()
	} else {
		@present(f, text, model)
	}
}

// dash is what a value that is not there says, to the eye and to a screen reader.
templ dash() {
	<span class="dim" aria-hidden="true">—</span>
	<span class="sr-only">empty</span>
}

// present is a value that is there.
templ present(f ir.Field, text string, model any) {
	switch f.Display {
		case ir.DisplaySlider:
			@c.Gauge(gauge(f, text))
		case ir.DisplaySelect:
			<span class="badges">
				for _, val := range ir.SplitValues(text) {
					@c.Badge(c.BadgeProps{Tone: c.Tone(f.ToneOf(val)), Dot: true}) {
						{ f.LabelOf(val) }
					}
				}
			</span>
		case ir.DisplayLink:
			if href := linkOf(f, model); href != "" {
				<a class="ext" href={ href } target="_blank" rel="noopener noreferrer">
					{ text }
					@c.Icon(c.IconProps{Name: c.IconExternal, Class: "ext-icon"})
					<span class="sr-only">(opens in a new tab)</span>
				</a>
			} else {
				{ text }
			}
		case ir.DisplayTime:
			if moment := momentOf(f, model); moment != "" {
				<time datetime={ moment }>{ text }</time>
			} else {
				{ text }
			}
		default:
			if f.Multiline {
				<span class="multiline">{ text }</span>
			} else {
				{ text }
			}
	}
}

// Form renders a loaded form leaf as one panel. The submit button and its
// Cancel sit in the footer, inside the <form>, so they submit it. When the
// submit is refused (SubmitGate) they are replaced by a Back button.
templ (r *Renderer) Form(v FormView) {
	@c.Panel(c.PanelProps{
		Title:  v.Node.Title,
		Desc:   v.Node.Desc,
		Failed: v.Failed, Refused: refusedOf(v.Refusal),
		Leaf:   LeafID(v.Node.At),
	}) {
		@c.Form(c.FormProps{
			Action: r.PageHref(v.Page, v.Path, v.Query),
			Attrs:  templ.Attributes{"data-leaf-form": LeafID(v.Node.At)},
		}) {
			<input type="hidden" name="_leaf" value={ LeafID(v.Node.At) }/>
			if v.Node.Editor != nil {
				@r.editorBody(v)
			} else {
				<div class="panel-body pad">
					for _, f := range v.Node.Fields {
						@r.formField(v, f)
					}
				</div>
			}
			if v.Node.Submit != nil && v.SubmitGate != "" {
				// A visitor who may not save has nothing to save or cancel: the footer
				// offers the way back, or no footer when there is no way back.
				if v.CancelHref != "" {
					<div class="panel-foot end">
						@c.Button(c.ButtonProps{Href: v.CancelHref, Variant: c.VariantGhost, Size: c.SizeSmall}) {
							Back
						}
					</div>
				}
			} else if v.Node.Submit != nil {
				<div class="panel-foot end">
					if v.CancelHref != "" {
						@c.Button(c.ButtonProps{Href: v.CancelHref, Variant: c.VariantGhost, Size: c.SizeSmall}) {
							Cancel
						}
					}
					if v.Node.Submit.Confirm != "" {
						// Pressing Enter in a field clicks the first submit button of the form, which would be the one in the dialog and
						// would not ask. This one is disabled, which makes Enter do nothing: the way to save is the button.
						<button type="submit" disabled hidden tabindex="-1" aria-hidden="true"></button>
					}
					@c.Button(c.ButtonProps{
						Variant: variant(v.Node.Submit.Role), Size: c.SizeSmall,
						Confirm: v.Node.Submit.Confirm, ConfirmID: confirmID(v.Node.At, "submit", 0),
					}) {
						{ v.Node.Submit.Label }
					}
				</div>
			}
		}
	}
}

// formField is a field, or a group of them side by side. A group is layout and
// nothing else: it has no frame, because a panel never nests another container.
templ (r *Renderer) formField(v FormView, f ir.Field) {
	if len(f.Group) > 0 {
		@c.FieldRow() {
			for _, child := range f.Group {
				@r.input(r.fieldView(ctx, v, child))
			}
		}
	} else {
		@r.input(r.fieldView(ctx, v, f))
	}
}

templ (r *Renderer) input(fv fieldView) {
	@c.Field(c.FieldProps{
		For: fv.ID, Label: fv.Field.Label, Required: fv.Rules.Required,
		Error: fv.Error, Rules: fv.RuleLines, Help: fv.Field.Help, Static: fv.ReadOnly,
	}) {
		switch {
			case fv.Field.Display == ir.DisplaySlider && !fv.ReadOnly:
				// The number is the control: it is what is submitted, and it has the rules, so it works without script. With
				// script there is a range beside it to drag, which holds no name and is only a way to move the number, so it
				// is out of the tab order and hidden from a screen reader, which has the number.
				<div class="range" data-range>
					<span class="js-only">
						<input
							class={ "range-input", templ.KV("invalid", fv.Error != "") }
							type="range"
							value={ fv.Value }
							min={ num(*fv.Rules.Min) }
							max={ num(*fv.Rules.Max) }
							step={ fv.Rules.Step }
							tabindex="-1"
							aria-hidden="true"
						/>
					</span>
					@c.Input(c.InputProps{
						ID: fv.ID, Name: fv.Name, Value: fv.Value, Type: fv.Type, Mono: true, Class: "range-number", Placeholder: fv.Placeholder,
						Invalid: fv.Error != "", Rules: fv.Rules, Validity: fv.Validity, Title: fv.Title, Form: fv.FormID,
					})
				</div>
			case fv.ReadOnly:
				// A value that cannot be changed, a badge and a bar among them: shown as
				// output, and not as an input that is refused. An empty one says so with a dash.
				<div class="static">
					if fv.Value == "" && (fv.Field.Display == ir.DisplayText || fv.Field.Display == ir.DisplayTime || fv.Field.Display == ir.DisplayLink || fv.Field.Display == ir.DisplaySelect) {
						@dash()
					} else {
						@value(fv.Field, fv.Value, fv.Model)
					}
				</div>
			case fv.Field.Multiline:
				@c.Textarea(c.TextareaProps{
					ID: fv.ID, Name: fv.Name, Value: fv.Value, Placeholder: fv.Field.Placeholder, Invalid: fv.Error != "",
					Rules: fv.Rules, Validity: fv.Validity, Form: fv.FormID,
				})
			case fv.Field.Display == ir.DisplaySelect:
				@c.Select(c.SelectProps{
					ID: fv.ID, Name: fv.Name, Choices: fv.choices(), Multi: fv.Field.Multi,
					Required: fv.Rules.Required, Invalid: fv.Error != "", Validity: fv.Validity, Form: fv.FormID,
				})
			default:
				@c.Input(c.InputProps{
					ID: fv.ID, Name: fv.Name, Value: fv.Value, Type: fv.Type,
					Placeholder: fv.Placeholder, Invalid: fv.Error != "",
					Rules: fv.Rules, Validity: fv.Validity, Title: fv.Title, Parts: fv.Parts, Form: fv.FormID, Autocomplete: fv.Autocomplete, Attrs: fv.Attrs,
				})
		}
		if fv.FormID != "" {
			// An input of a toolbar is applied with a button of its own without script, joined to it (see .toolbar .field).
			<button class="btn btn-secondary btn-sm toolbar-apply" type="submit" form={ fv.FormID }>Apply</button>
		}
	}
}

// Refused is the content of a page that a Guard refused with a status of its own, with what it said and, when it gave one,
// a link on from there.
templ Refused(ref *ir.Refusal) {
	@c.StatePage(c.StatePageProps{Icon: refusalIcon(ref.Status), Title: refusalTitle(ref.Status), Desc: ref.Message}) {
		if ref.Href != "" {
			@c.Button(c.ButtonProps{Href: ref.Href, Variant: c.VariantGhost, Size: c.SizeSmall}) {
				{ ref.Label }
			}
		}
	}
}

// Toolbar is a row of controls: buttons, links, and the values of the page's arguments, read-only. It is not a panel. The buttons
// post, in one form, by their position; a toolbar with no button has no form, since there is nothing in it to submit. A value
// is its label and what the accessor reads from the page's arguments, as a read-only form field shows it. The controls for the
// left and the right are one row, with a gap between the two groups that takes what is left over; script says when there is
// not room for them all in a row, and then the gap is gone and they flow as one.
templ (r *Renderer) Toolbar(v ToolbarView) {
	if v.Failed {
		@c.Panel(c.PanelProps{Failed: true, Leaf: LeafID(v.Node.At)}) {
		}
	} else {
		<div class="toolbar" data-toolbar>
			if v.hasActions() {
				@c.Form(c.FormProps{Action: r.PageHref(v.Page, v.Path, v.Query)}) {
					<input type="hidden" name="_leaf" value={ LeafID(v.Node.At) }/>
					@r.toolbarItems(v)
				}
			} else {
				@r.toolbarItems(v)
			}
		</div>
	}
}

// toolbarItems are the controls of a toolbar, in order, with the gap before the right ones.
templ (r *Renderer) toolbarItems(v ToolbarView) {
	for i, it := range v.Node.Items {
		if i == v.Node.RightFrom {
			<span class="toolbar-gap" aria-hidden="true"></span>
		}
		switch {
			case it.Action != nil:
				@c.Button(c.ButtonProps{Variant: variant(it.Role), Size: c.SizeSmall, Name: "_act", Value: strconv.Itoa(i), Guard: v.Gates[i], Confirm: it.Action.Confirm, ConfirmID: confirmID(v.Node.At, "t", i)}) {
					{ it.Label }
				}
			case it.Link != nil:
				@c.Button(c.ButtonProps{Variant: variant(it.Role), Size: c.SizeSmall, Href: v.Hrefs[i], Guard: v.Gates[i]}) {
					{ it.Label }
				}
			case it.Field != nil:
				{{ shown := it.Field.Shown(ctx, v.Args) }}
				<span class="toolbar-value">
					<span class="toolbar-lbl">{ it.Field.Label }</span>
					if it.Field.Help != "" {
						@c.InfoTip(c.InfoTipProps{Help: it.Field.Help})
					}
					<span class="toolbar-val">
						if shown == "" {
							@dash()
						} else {
							@value(*it.Field, shown, v.Args)
						}
					</span>
				</span>
		}
	}
}

// Tabs is the strip and the selected panel, in one element, so that a layout that arranges its children (a Split puts
// them in a grid) sees one child. The strip is links, because the selected tab is a page argument: it is in the
// address, survives a reload, and works without script.
//
// With script a tab is followed by asking for this element alone (see LeafHeader), which loads only the tab that is
// selected: data-tabs is its id, in the same form as a panel's, and data-tabkey is the argument that selects the tab,
// which the page's other links carry and script puts right.
templ Tabs(label string, strip []c.Tab, content templ.Component, id, key string) {
	<div class="tabset" data-tabs={ id } data-tabkey={ key }>
		@c.Tabs(c.TabsProps{Tabs: strip, Label: label})
		<div data-tabbody>
			@content
		</div>
	</div>
}

// filterMenu is a column's filter: an icon beside the name that appears when the
// header is hovered or focused, and stays once a filter is set. It is a plain
// <details> holding a GET form, so it opens, submits and clears without script.
// A column with a fixed set of options offers a multi-select of exactly those, a
// numeric column a minimum and a maximum, and any other takes text.
templ (r *Renderer) filterMenu(v TableView, f ir.Field) {
	{{ fv := r.filter(v, f) }}
	<details class={ "filter", templ.KV("on", fv.On) }>
		<summary class="filter-btn" title={ "Filter " + fv.Label } aria-label={ "Filter " + fv.Label }>
			@c.Icon(c.IconProps{Name: c.IconFilter})
		</summary>
		<form class="filter-pop" method="get" action={ fv.Action } data-filter-form>
			for _, h := range fv.Carry {
				<input type="hidden" name={ h.Name } value={ h.Value }/>
			}
			<div class="filter-title">{ fv.Label }</div>
			if fv.Numeric && fv.Moment {
				<div class="filter-range moment">
					<label>
						<span>From</span>
						<input class="input" type={ fv.boundType() } name={ fv.MinKey } value={ fv.Min } aria-label={ "From " + fv.Label + " (UTC)" }/>
					</label>
					<label>
						<span>To</span>
						<input class="input" type={ fv.boundType() } name={ fv.MaxKey } value={ fv.Max } aria-label={ "To " + fv.Label + " (UTC)" }/>
					</label>
					<span class="filter-note">UTC</span>
				</div>
			} else if fv.Numeric {
				<div class="filter-range">
					<label>
						<span>Min</span>
						<input class="input" type="number" step="any" name={ fv.MinKey } value={ fv.Min } aria-label={ "Minimum " + fv.Label }/>
					</label>
					<label>
						<span>Max</span>
						<input class="input" type="number" step="any" name={ fv.MaxKey } value={ fv.Max } aria-label={ "Maximum " + fv.Label }/>
					</label>
				</div>
			} else if fv.Options != nil {
				<div class="filter-options">
					for _, opt := range fv.Options {
						<label class="filter-opt">
							@c.Checkbox(c.CheckboxProps{Name: fv.Key, Value: opt, Checked: slices.Contains(fv.Chosen, opt)})
							<span>{ fv.name(opt) }</span>
						</label>
					}
				</div>
			} else {
				<input
					class="input"
					type="search"
					name={ fv.Key }
					value={ fv.text() }
					placeholder="Contains…"
					maxlength="200"
					aria-label={ "Filter " + fv.Label }
				/>
			}
			<div class="filter-actions">
				if fv.Clear != "" {
					@c.Button(c.ButtonProps{Href: fv.Clear, Variant: c.VariantGhost, Size: c.SizeSmall}) {
						Clear
					}
				}
				@c.Button(c.ButtonProps{Variant: c.VariantPrimary, Size: c.SizeSmall}) {
					Apply
				}
			</div>
		</form>
	</details>
}

// editorBody is a code editor's text. It is a textarea when the visitor can edit it and
// the text in a block when they cannot, and both work as they are: script mounts Monaco
// over them and keeps the textarea in step, so the form posts as it always did. The
// newline ahead of the text is dropped by the browser, and is there so that a text that
// begins with one keeps it.
templ (r *Renderer) editorBody(v FormView) {
	{{ f := v.Node.Fields[0] }}
	{{ fv := r.fieldView(ctx, v, f) }}
	<div class="panel-body code-body">
		<div
			class="code-editor"
			data-code-editor
			data-language={ v.Node.Editor.Language }
			data-label={ f.Label }
			if !fv.ReadOnly && v.Node.Editor.Context != nil {
				data-context={ v.Node.Editor.Context.ID }
			}
		>
			if fv.ReadOnly {
				<pre class="code-view" tabindex="0" aria-label={ f.Label }>{ "\n" + fv.Value }</pre>
			} else {
				<textarea
					class="code-text"
					id={ fv.ID }
					name={ fv.Name }
					aria-label={ f.Label }
					spellcheck="false"
					autocomplete="off"
					autocapitalize="off"
					wrap="off"
					required?={ fv.Rules.Required }
					if fv.Rules.MaxLen > 0 {
						maxlength={ strconv.Itoa(fv.Rules.MaxLen) }
					}
					if fv.Error != "" {
						aria-invalid="true"
						aria-describedby={ fv.ID + "-error" }
					}
				>{ "\n" + fv.Value }</textarea>
			}
		</div>
		if fv.Error != "" {
			<div class="err code-error" id={ fv.ID + "-error" }>
				@c.Icon(c.IconProps{Name: c.IconAlert})
				{ fv.Error }
			</div>
		}
	</div>
}

// Diff renders a diff leaf as one panel: the two texts and what changed. The page holds
// the changes as a unified diff, which the server made, and the two texts apart for
// Monaco, which replaces the diff with its own when script runs.
templ (r *Renderer) Diff(v DiffView) {
	@c.Panel(c.PanelProps{
		Title:  v.Node.Title,
		Desc:   v.Node.Desc,
		Failed: v.Failed, Refused: refusedOf(v.Refusal),
		Leaf:   LeafID(v.Node.At),
	}) {
		<div class="panel-body code-body">
			<div class="code-sides" aria-hidden="true">
				<span>{ v.Node.Original.Label }</span>
				<span>{ v.Node.Modified.Label }</span>
			</div>
			<div class="code-diff" data-code-diff data-language={ v.Node.Language } data-label={ v.Node.Title }>
				<pre hidden data-side="original">{ "\n" + v.Original }</pre>
				<pre hidden data-side="modified">{ "\n" + v.Modified }</pre>
				@r.unified(v)
			</div>
		</div>
	}
}

// Markdown renders a markdown leaf as one panel: the text, set as markup. The text was
// rendered by internal/markdown, which leaves nothing in it that could run, so it is
// put in the page as it is.
templ (r *Renderer) Markdown(v MarkdownView) {
	@c.Panel(c.PanelProps{
		Title:  v.Node.Title,
		Desc:   v.Node.Desc,
		Failed: v.Failed, Refused: refusedOf(v.Refusal),
		Leaf:   LeafID(v.Node.At),
	}) {
		<div class="panel-body pad">
			<article class="md" aria-label={ v.Node.Content.Label }>
				@templ.Raw(v.Result.HTML)
			</article>
		</div>
	}
}

// unified is the changes as a unified diff, the way to read them without script.
templ (r *Renderer) unified(v DiffView) {
	<div class="udiff" role="region" tabindex="0" aria-label={ v.Node.Original.Label + " and " + v.Node.Modified.Label + ", compared" }>
		switch {
			case !v.Compared:
				<p class="udiff-note">These two are too large or too different to compare here. Script shows them side by side.</p>
			case len(v.Hunks) == 0:
				<p class="udiff-note">No differences.</p>
			default:
				<p class="udiff-sum"><span class="ins">+{ strconv.Itoa(v.Added) }</span> <span class="del">−{ strconv.Itoa(v.Removed) }</span></p>
				for i, h := range v.Hunks {
					if i > 0 {
						<div class="udiff-gap" aria-hidden="true">⋯</div>
					}
					for _, line := range h.Lines {
						{{ class, mark := lineMark(line.Kind) }}
						<div class={ "udiff-line", class }>
							<span class="udiff-n" aria-hidden="true">{ lineNumber(line.Old) }</span>
							<span class="udiff-n" aria-hidden="true">{ lineNumber(line.New) }</span>
							<span class="udiff-m" aria-hidden="true">{ mark }</span>
							<code>{ line.Text }</code>
						</div>
					}
				}
		}
	</div>
}
