// Package templates assembles pages from the component library. A page is glue:
// it decides what goes where, and the components decide how it looks.
package templates

// PageProps is one rendered screen. Every field is a region of the shell; the
// body is { children... }. Nothing here is IR — internal/render maps ir.App and
// ir.Page onto this and onto component props, which is the only place the two
// vocabularies meet.
type PageProps struct {
	Title       string
	Early       templ.Component
	Stylesheets []string
	Scripts     []string
	Head        templ.Component

	Sidebar templ.Component
	TopBar  templ.Component
	Status  templ.Component
	Toasts  templ.Component

	// Streaming is a page that is sent as it is built. It has a mark where the content is still arriving, which is
	// drawn after the content and is hidden by what ends it, and its status bar in two parts: StatusLive with the
	// shell, in place of Status, and StatusLate when all of the page has been sent.
	Streaming  bool
	StatusLive templ.Component
	StatusLate templ.Component
}

templ Page(p PageProps) {
	@Document(DocumentProps{
		Title:       p.Title,
		Early:       p.Early,
		Stylesheets: p.Stylesheets,
		Scripts:     p.Scripts,
		Head:        p.Head,
	}) {
		@AppShell(AppShellProps{
			Sidebar: p.Sidebar,
			TopBar:  p.TopBar,
			Status:  p.Status,
			Toasts:  p.Toasts,

			Streaming:  p.Streaming,
			StatusLive: p.StatusLive,
			StatusLate: p.StatusLate,
		}) {
			{ children... }
		}
	}
}
