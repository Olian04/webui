// Package templates assembles pages from the component library. A page is glue:
// it decides what goes where, and the components decide how it looks.
package templates

// PageProps is one rendered screen. Every field is a region of the shell; the
// body is { children... }. Nothing here is IR — internal/render maps ir.App and
// ir.Page onto this and onto component props, which is the only place the two
// vocabularies meet.
type PageProps struct {
	Title       string
	Stylesheets []string
	Scripts     []string
	Head        templ.Component

	Sidebar templ.Component
	TopBar  templ.Component
	Status  templ.Component
	Toasts  templ.Component
}

templ Page(p PageProps) {
	@Document(DocumentProps{
		Title:       p.Title,
		Stylesheets: p.Stylesheets,
		Scripts:     p.Scripts,
		Head:        p.Head,
	}) {
		@AppShell(AppShellProps{
			Sidebar: p.Sidebar,
			TopBar:  p.TopBar,
			Status:  p.Status,
			Toasts:  p.Toasts,
		}) {
			{ children... }
		}
	}
}
