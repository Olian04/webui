package components

import "strconv"

// Rules is the constraint set a field declares, expressed as the HTML
// attributes it produces. The browser enforces them before anything is sent;
// the server re-runs the same set after. One declaration, two enforcements —
// and the first one needs no script.
//
// Min and Max are pointers because zero is a real bound. MinLen and MaxLen are
// plain ints because a zero-length minimum is not a constraint.
type Rules struct {
	Required bool
	MinLen   int
	MaxLen   int
	Min      *float64
	Max      *float64
	Pattern  string
	Step     string
}

func num(f *float64) string {
	if f == nil {
		return ""
	}
	return strconv.FormatFloat(*f, 'f', -1, 64)
}

// FieldProps is the label and error that wrap a control. The control itself is
// { children... }: a field has no opinion about whether it holds an input, a
// select or something this package has not met yet.
type FieldProps struct {
	// For must match the control's id, or the label is decorative.
	For      string
	Label    string
	Required bool
	Error    string

	// Rules is every constraint on the value other than Required, in words, behind an
	// information icon beside the label, so it is there while the value is good and
	// takes no room beneath the control.
	Rules []string

	// Help is what the field is for, in the same popover as the rules, under a heading of its own and above them.
	Help string

	// Static is a field that shows a value and offers no control: the label sits
	// closer to the value, which has a height of its own.
	Static bool
}

// rulesTitle is the heading of the rules in the popover, and nothing when there are none and it holds the help alone.
func (p FieldProps) rulesTitle() string {
	if len(p.Rules) == 0 {
		return ""
	}
	return "Rules:"
}

templ Field(p FieldProps) {
	<div class={ "field", templ.KV("field-static", p.Static) }>
		if p.Label != "" {
			<div class="lbl-row">
				<label class="lbl" id={ p.For + "-label" } for={ p.For }>
					{ p.Label }
					if p.Required {
						<span class="req" aria-hidden="true">*</span>
					}
				</label>
				if p.Help != "" || len(p.Rules) > 0 {
					@InfoTip(InfoTipProps{Help: p.Help, Text: p.rulesTitle(), Lines: p.Rules})
				}
			</div>
		}
		{ children... }
		if p.Error != "" {
			<div class="err" id={ p.For + "-error" }>
				@Icon(IconProps{Name: IconAlert})
				{ p.Error }
			</div>
		}
	</div>
}

// FieldRow puts two fields side by side, collapsing to one column on a narrow
// window.
templ FieldRow() {
	<div class="field-row">
		{ children... }
	</div>
}

// InputProps is a text-like control.
type InputProps struct {
	ID          string
	Name        string
	Value       string
	Type        string
	Placeholder string
	Mono        bool
	Invalid     bool
	Rules       Rules

	// Class is a class of the caller's own, besides the input's.
	Class string

	// Autocomplete is the input's autocomplete, when it has one.
	Autocomplete string

	// Validity is what the browser says for each way the value can fail a constraint, as JSON by the name of the
	// property of the control's ValidityState (valueMissing, patternMismatch, ...), for script to give to
	// setCustomValidity. Title is what a value that matches the pattern looks like, which a browser says after its own
	// words when script is off.
	Validity string
	Title    string

	// Parts is, for a field that has more than one condition on its text, each of them as a JavaScript regular
	// expression with what to say when a value does not match it, as JSON: [["expression", "message"], ...]. Script
	// uses it to say which one a value fails when the browser reports the pattern. It has no effect without script.
	Parts string

	// Attrs are attributes of the caller's own, such as the data attributes that script reads.
	Attrs templ.Attributes
}

templ Input(p InputProps) {
	<input
		if p.ID != "" {
			id={ p.ID }
		}
		class={ "input", templ.KV("mono", p.Mono), templ.KV("invalid", p.Invalid), templ.KV(p.Class, p.Class != "") }
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Type != "" {
			type={ p.Type }
		} else {
			type="text"
		}
		value={ p.Value }
		if p.Placeholder != "" {
			placeholder={ p.Placeholder }
		}
		required?={ p.Rules.Required }
		if p.Rules.MinLen > 0 {
			minlength={ strconv.Itoa(p.Rules.MinLen) }
		}
		if p.Rules.MaxLen > 0 {
			maxlength={ strconv.Itoa(p.Rules.MaxLen) }
		}
		if p.Rules.Min != nil {
			min={ num(p.Rules.Min) }
		}
		if p.Rules.Max != nil {
			max={ num(p.Rules.Max) }
		}
		if p.Rules.Step != "" {
			step={ p.Rules.Step }
		}
		if p.Rules.Pattern != "" {
			pattern={ p.Rules.Pattern }
		}
		if p.Title != "" {
			title={ p.Title }
		}
		if p.Validity != "" {
			data-validity={ p.Validity }
		}
		if p.Parts != "" {
			data-parts={ p.Parts }
		}
		if p.Autocomplete != "" {
			autocomplete={ p.Autocomplete }
		}
		if p.Invalid {
			aria-invalid="true"
			aria-describedby={ p.ID + "-error" }
		}
		{ p.Attrs... }
	/>
}

// FileInputProps is a file chooser, with the file that is stored shown above it. The chooser has no value, which a browser never
// lets a page give a file input, so a file that was chosen and not sent has to be chosen again.
type FileInputProps struct {
	ID       string
	Name     string
	Accept   string // the accept attribute, a hint to the chooser and nothing more
	Required bool
	Invalid  bool

	// Validity is what the browser says for each way the value can fail a constraint, as JSON (see InputProps).
	Validity string

	// CurrentName is the stored file's name, "" for none; CurrentHref is where it is served, "" for no link; CurrentSize is
	// how large it is, as read, "" for not knowing.
	CurrentName, CurrentHref, CurrentSize string

	// CurrentThumb is where a small picture of the stored file is, "" for none. It is shown at 32 pixels, and links to the file at full size
	// when there is an address for it, which script opens in a dialog and without script is a link to the file.
	CurrentThumb string

	// Remove is the value of the checkbox that asks for the stored file to be removed, which is the field's name; "" for a
	// file that cannot be.
	Remove string

	// Attrs are attributes of the caller's own, such as the data attributes that script reads.
	Attrs templ.Attributes
}

templ FileInput(p FileInputProps) {
	<div class="file">
		if p.CurrentName != "" {
			<div class="file-current">
				if p.CurrentThumb != "" && p.CurrentHref != "" {
					// The thumbnail opens the file at full size in a native dialog, with an invoker command as a button that asks does, so it needs no
					// script. The image is lazy: in a dialog that is closed it has no box, so it is not fetched until the dialog is opened.
					<button
						class="file-thumb-link"
						type="button"
						commandfor={ p.ID + "-preview" }
						command="show-modal"
						aria-haspopup="dialog"
						aria-label={ "Preview " + p.CurrentName }
						title={ "Preview " + p.CurrentName }
					><img class="file-thumb" src={ p.CurrentThumb } alt=""/></button>
					<dialog id={ p.ID + "-preview" } class="preview-dialog" closedby="any" aria-label={ "Preview of " + p.CurrentName }>
						<img class="preview-full" src={ p.CurrentHref } alt={ p.CurrentName } loading="lazy" decoding="async"/>
						<div class="preview-name">{ p.CurrentName }</div>
						<button class="btn btn-ghost btn-sm preview-close" type="button" commandfor={ p.ID + "-preview" } command="close" autofocus>Close</button>
					</dialog>
				} else if p.CurrentThumb != "" {
					<img class="file-thumb" src={ p.CurrentThumb } alt=""/>
				}
				if p.CurrentHref != "" {
					<a href={ p.CurrentHref }>{ p.CurrentName }</a>
				} else {
					<span>{ p.CurrentName }</span>
				}
				if p.CurrentSize != "" {
					<span class="dim">{ p.CurrentSize }</span>
				}
				if p.Remove != "" {
					<label class="file-remove"><input class="checkbox" type="checkbox" name="_rm" value={ p.Remove }/> Remove</label>
				}
			</div>
		}
		<input
			if p.ID != "" {
				id={ p.ID }
			}
			class={ "input", "file-input", templ.KV("invalid", p.Invalid) }
			type="file"
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Accept != "" {
				accept={ p.Accept }
			}
			required?={ p.Required }
			if p.Validity != "" {
				data-validity={ p.Validity }
			}
			if p.Invalid {
				aria-invalid="true"
				aria-describedby={ p.ID + "-error" }
			}
			{ p.Attrs... }
		/>
	</div>
}

// TextareaProps is a text of more than one line. It has the rules that a text area has: required, minlength and maxlength, and not a
// pattern. The text is drawn after a newline, which the parser drops, so a text that begins with one keeps it.
type TextareaProps struct {
	ID          string
	Name        string
	Value       string
	Placeholder string
	Invalid     bool
	Rules       Rules

	// Validity is as for an Input.
	Validity string
}

templ Textarea(p TextareaProps) {
	<textarea
		if p.ID != "" {
			id={ p.ID }
		}
		class={ "input", "textarea", templ.KV("invalid", p.Invalid) }
		if p.Name != "" {
			name={ p.Name }
		}
		rows="5"
		if p.Placeholder != "" {
			placeholder={ p.Placeholder }
		}
		required?={ p.Rules.Required }
		if p.Rules.MinLen > 0 {
			minlength={ strconv.Itoa(p.Rules.MinLen) }
		}
		if p.Rules.MaxLen > 0 {
			maxlength={ strconv.Itoa(p.Rules.MaxLen) }
		}
		if p.Validity != "" {
			data-validity={ p.Validity }
		}
		if p.Invalid {
			aria-invalid="true"
			aria-describedby={ p.ID + "-error" }
		}
	>{ "\n" + p.Value }</textarea>
}

// SelectChoice is one option of a Select.
type SelectChoice struct {
	Value    string
	Label    string
	Selected bool
	Tone     Tone // how the option is drawn when script presents the list: as the badge it is when read
}

// SelectProps is a choice from a list. Without Multi it is a drop-down list, with an empty
// option first for none, or, when a choice is Required, for the visitor to have to make one.
// With Multi it is a list to tick any number of, sent as one value for each, which is what a
// browser does without script. It is a real <select> either way, and is what is submitted:
// with script it is hidden and replaced by a field that shows the choice as badges, over a
// list of the options, each ticked by a click. The options say the badge each is drawn as, so
// the script needs nothing but the markup.
type SelectProps struct {
	ID       string
	Name     string
	Choices  []SelectChoice
	Multi    bool
	Required bool
	Invalid  bool
	Validity string // as for an Input
}

// size is how many options a list shows before it scrolls.
func (p SelectProps) size() string {
	return strconv.Itoa(min(max(len(p.Choices), 2), 6))
}

templ Select(p SelectProps) {
	<select
		data-select
		if p.ID != "" {
			id={ p.ID }
		}
		class={ "input", templ.KV("invalid", p.Invalid) }
		if p.Name != "" {
			name={ p.Name }
		}
		required?={ p.Required }
		if p.Validity != "" {
			data-validity={ p.Validity }
		}
		if p.Multi {
			multiple
			size={ p.size() }
		}
		if p.Invalid {
			aria-invalid="true"
			aria-describedby={ p.ID + "-error" }
		}
	>
		if !p.Multi {
			<option value="">
				if p.Required {
					Choose…
				} else {
					—
				}
			</option>
		}
		for _, c := range p.Choices {
			<option value={ c.Value } data-badge={ c.Tone.badge() } selected?={ c.Selected }>{ c.Label }</option>
		}
	</select>
}

type CheckboxProps struct {
	ID      string
	Name    string
	Value   string
	Label   string
	Checked bool
}

templ Checkbox(p CheckboxProps) {
	<input
		if p.ID != "" {
			id={ p.ID }
		}
		class="checkbox"
		type="checkbox"
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Value != "" {
			value={ p.Value }
		}
		if p.Label != "" {
			aria-label={ p.Label }
		}
		checked?={ p.Checked }
	/>
}

// SwitchProps is a session-level mode, never saved data. If flipping it writes
// something, it is a Checkbox in a form, not a Switch.
type SwitchProps struct {
	ID      string
	Label   string
	Checked bool
	Attrs   templ.Attributes
}

templ Switch(p SwitchProps) {
	<label class="switch">
		<input id={ p.ID } type="checkbox" aria-label={ p.Label } checked?={ p.Checked } { p.Attrs... }/>
		<span class="slider"></span>
	</label>
}

// FormProps wraps a leaf's controls. Method defaults to post: a form that only
// reads should be a link.
type FormProps struct {
	Action string
	Attrs  templ.Attributes
}

templ Form(p FormProps) {
	<form
		if p.Action != "" {
			action={ p.Action }
		}
		method="post"
		{ p.Attrs... }
	>
		{ children... }
	</form>
}
