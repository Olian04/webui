package components

// Crumb is one step of the breadcrumb trail. The last one has no Href: it is
// where you are.
type Crumb struct {
	Label string
	Href  string
}

type BreadcrumbsProps struct {
	Items []Crumb
	Attrs templ.Attributes
}

templ Breadcrumbs(p BreadcrumbsProps) {
	<nav class="crumbs" aria-label="Breadcrumb" { p.Attrs... }>
		for i, c := range p.Items {
			if i > 0 {
				<span class="sep" aria-hidden="true">&rsaquo;</span>
			}
			if c.Href != "" && i < len(p.Items)-1 {
				<a href={ c.Href }>{ c.Label }</a>
			} else {
				<span class="cur" aria-current="page">{ c.Label }</span>
			}
		}
	</nav>
}

// TopBarProps is the application chrome above the content. The breadcrumb
// lives here rather than in the page because it is the sidebar's partner: it
// carries the location the sidebar cannot show.
type TopBarProps struct {
	Crumbs []Crumb
	Attrs  templ.Attributes
}

templ TopBar(p TopBarProps) {
	<header class="topbar" { p.Attrs... }>
		@Breadcrumbs(BreadcrumbsProps{Items: p.Crumbs})
		<div class="top-right">
			{ children... }
		</div>
	</header>
}

type SearchProps struct {
	Placeholder string
	Shortcut    string
	Attrs       templ.Attributes
}

templ Search(p SearchProps) {
	<div class="search">
		@Icon(IconProps{Name: IconSearch})
		<input data-palette-input placeholder={ p.Placeholder } autocomplete="off" aria-label={ p.Placeholder } { p.Attrs... }/>
		if p.Shortcut != "" {
			<span class="kbd" aria-hidden="true">{ p.Shortcut }</span>
		}
	</div>
}

// MenuEntry is one link in an AppMenu. Section is a caption above this entry and the
// ones after it, until another entry starts its own.
type MenuEntry struct {
	Label   string
	Href    string
	Icon    IconName
	Section string
}

// AppMenu is the button in the top bar and the list of the app's own links behind
// it. It is a <details>, so it opens and closes without script; script only closes it
// on a click elsewhere or on Escape.
templ AppMenu(items []MenuEntry) {
	<details class="menu">
		<summary class="iconbtn" title="Menu" aria-label="Menu">
			@Icon(IconProps{Name: IconGear})
		</summary>
		<div class="menu-pop">
			for _, it := range items {
				if it.Section != "" {
					<div class="menu-section">{ it.Section }</div>
				}
				<a class="menu-item" href={ it.Href }>
					if it.Icon != IconNone {
						@Icon(IconProps{Name: it.Icon, Class: "menu-icon"})
					}
					<span>{ it.Label }</span>
				</a>
			}
		</div>
	</details>
}
