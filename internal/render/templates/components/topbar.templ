package components

// Crumb is one step of the breadcrumb trail. The last one has no Href: it is
// where you are.
type Crumb struct {
	Label string
	Href  string
}

// TopBarProps is the application chrome above the content. The breadcrumb
// lives here rather than in the page because it is the sidebar's partner: it
// carries the location the sidebar cannot show.
type TopBarProps struct {
	Crumbs []Crumb
	// Mark leads the bar when there is no sidebar to carry the app's mark. It is decoration: the first crumb is the brand's name.
	Mark templ.Component
	// Nav is whether the page has a sidebar, which a phone draws as a drawer: the button that opens it is the first thing in the bar.
	Nav bool
}

templ TopBar(p TopBarProps) {
	<header class="topbar">
		if p.Nav {
			// The checkbox that opens the drawer is beside the shell (see AppShell); this is its button, drawn only on a phone.
			<label class="iconbtn nav-open" for="nav-toggle" aria-hidden="true">
				@Icon(IconProps{Name: IconMenu})
			</label>
		}
		if p.Mark != nil {
			<span class="top-mark" aria-hidden="true">@p.Mark</span>
		}
		<nav class="crumbs" aria-label="Breadcrumb">
			for i, c := range p.Crumbs {
				if i > 0 {
					<span class="sep" aria-hidden="true">&rsaquo;</span>
				}
				if c.Href != "" && i < len(p.Crumbs)-1 {
					<a href={ c.Href }>{ c.Label }</a>
				} else {
					<span class="cur" aria-current="page">{ c.Label }</span>
				}
			}
		</nav>
		// On a phone the actions on the right (search, Refresh, the theme, the app's links) are one drawer, from the right, behind this button; a
		// checkbox opens it, so it needs no script. Above that width neither the box nor its button is drawn.
		<input type="checkbox" id="top-more" class="top-more-toggle" aria-label="More actions" aria-controls="top-right"/>
		<label class="iconbtn top-more" for="top-more" aria-hidden="true">
			@Icon(IconProps{Name: IconMore})
		</label>
		<label class="top-backdrop" for="top-more" aria-hidden="true"></label>
		<div class="top-right" id="top-right">
			{ children... }
		</div>
	</header>
}

// ThemeToggle is the light or dark theme as one icon button, in every top bar. It shows the theme that a press
// brings: the sun in the dark theme, the moon in the light one (the stylesheet picks, from the attribute script sets or from the system's choice). It is
// a switch, named by the theme it turns on, so a reader is told whether the light theme is on. Script is what makes the choice, so the button is only there with it.
templ ThemeToggle() {
	<div class="js-only">
		<button class="iconbtn theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Light theme" title="Light theme" data-pref-toggle="theme">
			@Icon(IconProps{Name: IconSun, Class: "ti-sun"})
			@Icon(IconProps{Name: IconMoon, Class: "ti-moon"})
		</button>
	</div>
}

// SearchProps is the search box: a form that goes to Action with what was typed as q. With script it is a box that lists
// its results beneath it as they are typed, and its button is not needed; without, the button is how it is submitted, and
// the answer is a page of results. Value is what was searched for, when the page is its results.
type SearchProps struct {
	Placeholder string
	Shortcut    string
	Action      string
	Value       string
	Attrs       templ.Attributes
}

templ Search(p SearchProps) {
	<form class="search" method="get" action={ p.Action } role="search">
		@Icon(IconProps{Name: IconSearch})
		<input data-palette-input type="text" name="q" value={ p.Value } enterkeyhint="search" placeholder={ p.Placeholder } autocomplete="off" aria-label={ p.Placeholder } { p.Attrs... }/>
		if p.Shortcut != "" {
			<span class="js-only"><span class="kbd" aria-hidden="true">{ p.Shortcut }</span></span>
		}
		<button class="btn btn-secondary btn-sm search-submit" type="submit">Search</button>
	</form>
}

// LinkEntry is one link in ExternalLinks. Section is a caption above this entry, which
// is the first of its group; the entries after it are in the group until another
// entry has a caption of its own. NewTab opens the link in a tab of its own.
type LinkEntry struct {
	Label   string
	Href    string
	Icon    IconName
	Section string
	NewTab  bool
}

// ExternalLinks is the button in the top bar and the list of the app's links to other
// places behind it. It is a <details>, so it opens and closes without script; script
// only closes it on a click elsewhere or on Escape.
templ ExternalLinks(items []LinkEntry) {
	<details class="menu">
		<summary class="iconbtn" title="External links" aria-label="External links">
			@Icon(IconProps{Name: IconExternal})
		</summary>
		<div class="menu-pop">
			for _, it := range items {
				if it.Section != "" {
					<div class="menu-section">{ it.Section }</div>
				}
				<a
					class="menu-item"
					href={ it.Href }
					if it.NewTab {
						target="_blank"
						rel="noopener noreferrer"
					}
				>
					if it.Icon != IconNone {
						@Icon(IconProps{Name: it.Icon, Class: "menu-icon"})
					}
					<span>{ it.Label }</span>
					if it.NewTab {
						<span class="sr-only"> (opens in a new tab)</span>
					}
				</a>
			}
		</div>
	</details>
}
