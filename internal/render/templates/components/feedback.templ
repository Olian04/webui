package components

import (
	"fmt"
	"time"
)

// ToastRegion is the live region toasts arrive in. It is rendered once per
// document, empty, so that a toast added later is announced.
templ ToastRegion() {
	<div class="toasts" data-toasts role="status" aria-live="polite">
		{ children... }
	</div>
}

type ToastProps struct {
	Tone  Tone
	Title string
	Desc  string

	// Name is what makes the toast's dismiss control its own radio group: two toasts
	// with the same Name would be one group, and choosing one would bring the other
	// back. It must differ between the toasts of a page.
	Name  string
	Attrs templ.Attributes
}

// Toast is a message, with a button to dismiss it that works without script: the
// button is a label for a visually hidden radio, and the stylesheet hides the toast
// whose radio is chosen. It is focusable by keyboard, where Space chooses it.
templ Toast(p ToastProps) {
	<div class={ "toast", templ.KV("warn", p.Tone == ToneWarning), templ.KV("err", p.Tone == ToneCritical) } { p.Attrs... }>
		<div class="toast-text">
			<div class="toast-title">{ p.Title }</div>
			if p.Desc != "" {
				<div class="toast-desc">{ p.Desc }</div>
			}
		</div>
		<label class="toast-close" title="Dismiss">
			<input class="sr-only" type="radio" name={ p.Name } aria-label="Dismiss"/>
			@Icon(IconProps{Name: IconClose})
		</label>
	</div>
}

// EmptyStateProps replaces a leaf's rows when there are none. It names the
// condition and then names the way out — an empty state that only says
// "nothing here" has wasted the one moment it had.
type EmptyStateProps struct {
	Icon  IconName
	Title string
	Desc  string
	Attrs templ.Attributes
}

templ EmptyState(p EmptyStateProps) {
	<div class="empty" { p.Attrs... }>
		@Icon(IconProps{Name: p.Icon})
		<div class="empty-title">{ p.Title }</div>
		if p.Desc != "" {
			<div class="empty-desc">{ p.Desc }</div>
		}
		{ children... }
	</div>
}

// StatusBarProps is the honesty bar: the request behind what is on screen. If
// the screen changed, this says what changed and how much of it. Beside the request it
// says how the page came to be: when its HTML was built and how long the server took, which
// is what shows a page that a cache or a proxy answered for the server, and, with
// script off, that it is off.
type StatusBarProps struct {
	Method string
	URL    string
	Note   string

	// Built is when the page's HTML was built, and BuildTime how long the server took from the
	// request's arrival to that. A zero Built is not shown.
	Built     time.Time
	BuildTime time.Duration

	Attrs templ.Attributes
}

func (p StatusBarProps) took() string {
	ms := float64(p.BuildTime.Microseconds()) / 1000
	if ms < 10 {
		return fmt.Sprintf("%.1f ms", ms)
	}
	return fmt.Sprintf("%.0f ms", ms)
}

templ StatusBar(p StatusBarProps) {
	<div class="statusbar" { p.Attrs... }>
		<span class="method" data-method>{ p.Method }</span>
		<span class="url" data-url>{ p.URL }</span>
		<span class="status-meta">
			<noscript>
				<span class="sb-badge sb-warn" title="JavaScript is off. Everything works as whole pages: there is no search box, no code editor, and a panel reloads the page.">JS off</span>
			</noscript>
			<span class="sb-badge sb-warn" data-stale hidden></span>
			if !p.Built.IsZero() {
				<span class="sb-opt" data-build title="How long the server took to build this page from the request's arrival">{ p.took() }</span>
				<span class="sb-opt" data-loaded hidden title="How long the browser took to get and show this page"></span>
				<time class="sb-opt" data-built datetime={ p.Built.UTC().Format(time.RFC3339Nano) } title={ "The HTML was built " + p.Built.UTC().Format("2006-01-02 15:04:05 UTC") }>{ "built " + p.Built.UTC().Format("15:04:05") + "Z" }</time>
			}
		</span>
		<span class={ "netlog", templ.KV("on", p.Note != "") } data-netlog>
			<span class="spin" aria-hidden="true"></span>
			<span data-netmsg>{ p.Note }</span>
		</span>
	</div>
}
