package components

import (
	"html"
	"strings"
)

// The sidebar is the one piece of structure that does not disappear, as long as
// the app declares a list to show: the page leaves it out when no page has an
// entry (see Renderer.hasSidebar). It does not become a top bar and it does not
// become a menu button on a desktop; on a phone it is a drawer.

// Footer is a slot rather than part of { children... } because it sits outside
// the scrolling nav: session switches are not navigation and must not scroll
// away with it.
type SidebarProps struct {
	Brand  string
	Logo   string // image address; empty draws the default mark
	Home   string // where the brand goes: the landing page. Empty makes it plain text
	Footer templ.Component
}

templ Sidebar(p SidebarProps) {
	<aside class="sidebar drawer drawer-left" id="sidebar">
		if p.Home != "" {
			<a class="side-brand" href={ p.Home } title={ p.Brand }>
				@brandMark(p)
			</a>
		} else {
			<div class="side-brand">
				@brandMark(p)
			</div>
		}
		<nav class="side-scroll" aria-label="Main">
			{ children... }
		</nav>
		if p.Footer != nil {
			@p.Footer
		}
	</aside>
}

templ brandMark(p SidebarProps) {
	@BrandLogo(p.Logo)
	<b>{ p.Brand }</b>
}

// BrandLogo is the app's mark: its logo, or the library's when it has none. It is decoration, since the brand's name is beside it.
templ BrandLogo(logo string) {
	if logo != "" {
		<img class="logo-img" src={ logo } alt=""/>
	} else {
		<div class="logo" aria-hidden="true"><span></span></div>
	}
}

// SidebarFooter holds session-level switches. It is separated from the nav
// because nothing in it navigates.
templ SidebarFooter() {
	<div class="side-foot">
		{ children... }
	</div>
}

// SidebarCollapse is the control that narrows the sidebar to its icon rail and
// widens it again. It needs script, and its state is a browser preference, so it
// lives in the footer with the other session switches.
templ SidebarCollapse() {
	<button class="side-row side-collapse" type="button" data-sidebar-toggle aria-expanded="true" aria-controls="sidebar" title="Collapse sidebar">
		<span>Collapse</span>
		@Icon(IconProps{Name: IconChevron, Class: "side-collapse-icon"})
	</button>
}

templ NavSection(label string) {
	<div class="nav-section caption" title={ label }>{ label }</div>
}

// NavItemProps is one entry.
// Active is set by the page, not derived here, because a page may borrow
// another page's entry: a detail page highlights the list it came from rather
// than adding an entry of its own, and the breadcrumb carries the position.
type NavItemProps struct {
	Label  string
	Href   string
	Icon   IconName
	Letter string // the label's initial, drawn where the sidebar is a rail, for an entry with no Icon
	Active bool
}

// NavItem is one entry of the sidebar. It is Go and not a templ component, for the same reason as Icon: it is on every page, once for each page of the app, and a component costs a closure, a
// context and the processing of its class for each. The markup is what the component made (icon_nav_test.go has it, to the byte): the address is made safe as templ makes it, and what a person
// wrote is escaped.
func NavItem(p NavItemProps) templ.Component {
	var b strings.Builder
	b.Grow(200 + 2*len(p.Label) + len(p.Href)) // the markup is these and about a hundred and fifty bytes: one allocation, and no regrowing
	b.WriteString(`<a class="nav-item`)
	if p.Active {
		b.WriteString(" active")
	}
	b.WriteString(`" href="`)
	b.WriteString(html.EscapeString(string(templ.URL(p.Href))))
	b.WriteString(`" title="`)
	b.WriteString(html.EscapeString(p.Label))
	b.WriteByte('"')
	if p.Active {
		b.WriteString(` aria-current="page"`)
	}
	b.WriteByte('>')
	if p.Icon != IconNone {
		b.WriteString(iconOf(p.Icon, "ni").markup)
	} else if p.Letter != "" {
		b.WriteString(`<span class="ni ni-letter" aria-hidden="true">` + html.EscapeString(p.Letter) + `</span> `)
	}
	b.WriteString("<span>" + html.EscapeString(p.Label) + "</span></a>")
	return templ.Raw(b.String())
}
