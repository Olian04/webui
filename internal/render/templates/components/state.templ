package components

import "strconv"

// StatePageProps replaces the whole content region with one thing to say: an icon, a title and what the visitor needs to
// know, and, as a child, a way on.
type StatePageProps struct {
	Icon  IconName
	Title string
	Desc  string
}

templ StatePage(p StatePageProps) {
	<div class="state-page">
		@Icon(IconProps{Name: p.Icon})
		<h2 class="state-title">{ p.Title }</h2>
		if p.Desc != "" {
			<p class="state-desc">{ p.Desc }</p>
		}
		{ children... }
	</div>
}

// Problem is one compile failure: where it is, what is wrong, and what to do.
// Fix is not optional. A problem a reader cannot act on is a problem reported
// badly.
type Problem struct {
	Where  string
	Detail string
	Fix    string
}

// CompileErrorProps replaces the application at every address until it
// compiles. Every problem is shown at once: the errors are structured rather
// than scraped from a compiler, so there is no reason to report them one at a
// time.
type CompileErrorProps struct {
	Problems []Problem
}

templ CompileError(p CompileErrorProps) {
	<div class="compile">
		<h1>Failed to compile</h1>
		<p class="count">{ problemCount(len(p.Problems)) }</p>
		for _, e := range p.Problems {
			<section>
				<div class="where">{ e.Where }</div>
				<pre>{ e.Detail }</pre>
				if e.Fix != "" {
					<p class="fix"><b>Fix:</b> { e.Fix }</p>
				}
			</section>
		}
		{ children... }
	</div>
}

func problemCount(n int) string {
	if n == 1 {
		return "1 problem in this app."
	}
	return strconv.FormatInt(int64(n), 10) + " problems in this app."
}
