package components

// ButtonProps describes one control.
// Href is the field that matters. A control that navigates renders as an <a>
// with a real address, so it works with scripting disabled, opens in a new tab
// on middle click, and is reachable by keyboard without any help. Leave Href
// empty only for a control that submits a form.
//
// Guard carries the reason the current viewer may not use a control that is drawn anyway: the control dims and
// explains itself. A control that the viewer is simply not offered is not given to Button at all; which of the two it
// is, is the application's to say, with what its Guard returns, and the same check rejects the request, so there is no
// second authorisation rule to keep in sync.
type ButtonProps struct {
	Href    string
	Variant Variant
	Size    Size
	Name    string
	Value   string

	// Disabled renders a control that cannot be used and has no explanation —
	// a pager at the end of its range. If there IS an explanation, use Guard.
	Disabled bool
	Guard    string

	// Confirm is a question to answer before the button submits: the button then opens a dialog, with ConfirmID, that says it
	// and has the button that submits and one to cancel. ConfirmID must be unique in the page.
	Confirm   string
	ConfirmID string

	Attrs templ.Attributes
}

templ Button(p ButtonProps) {
	if p.Guard != "" {
		// A control that its Guard disabled, with a reason, is in a wrapper that carries
		// the tooltip: opacity on the button itself would dim the tooltip too.
		// The reason is text that can be reached, and not only a tooltip: the wrapper takes the focus, which shows the tooltip as hover does, and a screen reader
		// reads the reason after the disabled button, since a disabled button itself cannot be focused.
		<span class="gate" data-guard={ p.Guard } tabindex="0">
			@Button(ButtonProps{
				Variant: p.Variant, Size: p.Size,
				Name: p.Name, Value: p.Value, Disabled: true, Attrs: p.Attrs,
			}) {
				{ children... }
			}
			<span class="sr-only">Not available: { p.Guard }</span>
		</span>
	} else if p.Confirm != "" && p.Href == "" && !p.Disabled {
		// A native dialog, opened by a button with an invoker command, so it needs no script. The dialog is inside the form
		// that the button is in, so the button in it submits that form, with the name and the value the button had.
		<button
			class={ "btn", p.Variant.btn(), p.Size.btn() }
			type="button"
			commandfor={ p.ConfirmID }
			command="show-modal"
			aria-haspopup="dialog"
			data-confirm-open
			{ p.Attrs... }
		>
			{ children... }
		</button>
		<dialog id={ p.ConfirmID } class="confirm" role="alertdialog" closedby="any" aria-labelledby={ p.ConfirmID + "-text" }>
			<p class="confirm-text" id={ p.ConfirmID + "-text" }>{ p.Confirm }</p>
			<div class="confirm-foot">
				<button class="btn btn-ghost btn-sm" type="button" commandfor={ p.ConfirmID } command="close" autofocus>Cancel</button>
				<button
					class={ "btn", p.Variant.btn(), "btn-sm" }
					type="submit"
					if p.Name != "" {
						name={ p.Name }
					}
					if p.Value != "" {
						value={ p.Value }
					}
				>
					{ children... }
				</button>
			</div>
		</dialog>
	} else if p.Href != "" && !p.Disabled {
		<a
			class={ "btn", p.Variant.btn(), p.Size.btn() }
			href={ p.Href }
			{ p.Attrs... }
		>
			{ children... }
		</a>
	} else if p.Href != "" {
		// A disabled link is not a link. Rendering an <a> without href would
		// leave a tab stop that goes nowhere.
		<span class={ "btn", p.Variant.btn(), p.Size.btn(), "disabled" } aria-disabled="true" { p.Attrs... }>
			{ children... }
		</span>
	} else {
		<button
			class={ "btn", p.Variant.btn(), p.Size.btn() }
			type="submit"
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Value != "" {
				value={ p.Value }
			}
			disabled?={ p.Disabled }
			{ p.Attrs... }
		>
			{ children... }
		</button>
	}
}

// IconButtonProps is a control whose whole label is its icon, so Title is
// required: it is the accessible name as well as the tooltip.
type IconButtonProps struct {
	Icon  IconName
	Title string
	Href  string
	Attrs templ.Attributes
}

templ IconButton(p IconButtonProps) {
	if p.Href != "" {
		<a class="iconbtn" href={ p.Href } title={ p.Title } aria-label={ p.Title } { p.Attrs... }>
			@Icon(IconProps{Name: p.Icon})
		</a>
	} else {
		<button class="iconbtn" type="button" title={ p.Title } aria-label={ p.Title } { p.Attrs... }>
			@Icon(IconProps{Name: p.Icon})
		</button>
	}
}
