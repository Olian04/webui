package components

import "fmt"

// DeltaProps is a signed change: its text, which carries the sign and the unit, which way it moved, and whether that is the good
// way. The sign and the arrow say the direction, so the colour is never the only thing that does; the tone is what the direction means.
type DeltaProps struct {
	Text string
	Sign int  // -1, 0 or 1: the arrow, and none for zero
	Tone Tone // ToneOK, ToneCritical or neutral
}

func (p DeltaProps) class() string {
	switch p.Tone {
	case ToneOK:
		return "delta tone-ok"
	case ToneCritical:
		return "delta tone-bad"
	case TonePrimary, ToneWarning, ToneNeutral:
	}
	return "delta"
}

// verdict is what the colour means, for a reader who does not see it.
func (p DeltaProps) verdict() string {
	switch p.Tone {
	case ToneOK:
		return " (better)"
	case ToneCritical:
		return " (worse)"
	case TonePrimary, ToneWarning, ToneNeutral:
	}
	return ""
}

templ Delta(p DeltaProps) {
	<span class={ p.class() }>
		if p.Sign > 0 {
			@Icon(IconProps{Name: IconArrowUp, Class: "delta-arrow"})
		} else if p.Sign < 0 {
			@Icon(IconProps{Name: IconArrowDown, Class: "delta-arrow"})
		}
		<span>{ p.Text }</span>
		if v := p.verdict(); v != "" {
			<span class="sr-only">{ v }</span>
		}
	</span>
}

// SparkProps is a small chart of a list of numbers, already laid out: a polyline through the points in a box
// of W by H. It is a picture that has the values in words as its name, so a reader who does not see it has them. The layout is the
// caller's, since a component does not know what a series is.
type SparkProps struct {
	Label string // the series in words: the name of the picture
	W, H  int

	// Line is the points of the polyline, "x,y x,y", and Dot the point that is marked on it.
	Line   string
	HasDot bool
	DotX   string
	DotY   string
}

templ Spark(p SparkProps) {
	<svg class="spark" viewBox={ fmt.Sprintf("0 0 %d %d", p.W, p.H) } role="img" aria-label={ p.Label } focusable="false">
		if p.Line != "" {
			<polyline class="spark-line" points={ p.Line }></polyline>
			if p.HasDot {
				<circle class="spark-dot" cx={ p.DotX } cy={ p.DotY } r="2.5"></circle>
			}
		}
	</svg>
}

// TrendProps is a figure's shape and its change, side by side: either part is nil when it is absent. A trend with neither is not drawn by this
// component, which has nothing to say for it: the caller says so.
type TrendProps struct {
	Delta *DeltaProps
	Spark *SparkProps
}

templ Trend(p TrendProps) {
	<span class="trend">
		if p.Spark != nil {
			@Spark(*p.Spark)
		}
		if p.Delta != nil {
			@Delta(*p.Delta)
		}
	</span>
}
