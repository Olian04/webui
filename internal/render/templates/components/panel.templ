package components

// PanelProps is the unit of content: a bordered region with a 32px header.
// Title and Desc are what make a grid of panels readable — a Split of two
// untitled boxes tells the reader nothing. Desc is carried by the information
// icon rather than printed, so the header stays one line tall.
//
// Actions and Footer are slots. They are slots rather than props because what
// goes in them is markup the panel has no opinion about: make the common
// configurable, make the uncommon composable.
type PanelProps struct {
	Title  string
	Desc   string
	Status Tone

	// Leaf is the address this panel can be refreshed at. A panel that is not
	// independently refreshable leaves it empty.
	Leaf string

	// Padded gives the body padding. A table sets it false and manages its own.
	Padded bool

	Actions templ.Component
	Footer  templ.Component
	Attrs   templ.Attributes
}

templ Panel(p PanelProps) {
	<div
		class="panel"
		if p.Leaf != "" {
			data-leaf={ p.Leaf }
		}
		{ p.Attrs... }
	>
		<div class="panel-head">
			<h2 class="panel-title">{ p.Title }</h2>
			if p.Desc != "" {
				@Icon(IconProps{Name: IconInfo, Class: "info", Title: p.Desc})
			}
			if p.Status == ToneOK {
				@Icon(IconProps{Name: IconOK, Class: "panel-status ok", Title: "Loaded"})
			}
			if p.Status == ToneCritical {
				@Icon(IconProps{Name: IconAlert, Class: "panel-status bad", Title: "Failed"})
			}
			<div class="panel-menu">
				if p.Actions != nil {
					@p.Actions
				}
				if p.Leaf != "" {
					@IconButton(IconButtonProps{
						Icon:  IconKebab,
						Title: "Refresh this panel",
						Attrs: templ.Attributes{"data-act": "refresh-leaf", "data-leaf": p.Leaf},
					})
				}
			</div>
		</div>
		<div class={ "panel-body", templ.KV("pad", p.Padded) }>
			{ children... }
		</div>
		if p.Footer != nil {
			<div class="panel-foot">
				@p.Footer
			</div>
		}
	</div>
}

// FieldGroupProps is a bordered group inside a panel body. Panels never nest;
// this is what content uses when it needs its own frame.
type FieldGroupProps struct {
	Legend string
	Attrs  templ.Attributes
}

templ FieldGroup(p FieldGroupProps) {
	<div class="group" { p.Attrs... }>
		if p.Legend != "" {
			<div class="group-legend">{ p.Legend }</div>
		}
		{ children... }
	</div>
}
