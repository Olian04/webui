package components

import (
	"context"
	"strconv"
	"strings"
	"time"
)

// PanelProps is the unit of content: a bordered region with a 32px header.
// Title and Desc are what make a grid of panels readable — a Split of two
// untitled boxes tells the reader nothing. Desc is carried by the information
// icon rather than printed, so the header stays one line tall.
//
// Footer is a slot rather than a prop because what goes in it is markup the panel
// has no opinion about: make the common configurable, make the uncommon composable.
type PanelProps struct {
	Title string
	Desc  string

	// Failed says the panel's Load failed: its head says so and its body is the one empty state
	// that says it could not load, in place of its content. The page stands.
	Failed bool

	// Refused is, for a panel whose Load said what the visitor may be told, in place of "Could not load".
	Refused *Refused

	// Retry is where a failed panel leads on to try again: the address of the page it is on, which asks for it again. "" for none.
	Retry string

	// Leaf names this panel so a link inside it can replace it on its own. A
	// panel that cannot be replaced independently leaves it empty.
	Leaf string

	// Grows is a panel whose body is the one thing on the page that scrolls, when the
	// page is not tall enough for it: it takes the height there is, its head and foot
	// stay put, and its body scrolls inside it. A panel that does not grow is its full
	// height, and the page scrolls to reach it.
	Grows bool

	Footer templ.Component
}

type refreshKey struct{}

// WithRefresh is ctx for drawing a panel that its Load said is not final: it is to be asked for again after d. The panel says so, to the
// reader in its head and to script in data-refresh-after, the delay in whole seconds, which script obeys until an answer does not say it.
func WithRefresh(ctx context.Context, d time.Duration) context.Context {
	return context.WithValue(ctx, refreshKey{}, d)
}

// refreshIn is the seconds after which the panel drawn with ctx is to be asked for again, 0 for a panel that is final.
func refreshIn(ctx context.Context) int {
	d, _ := ctx.Value(refreshKey{}).(time.Duration)
	if d <= 0 {
		return 0
	}
	return int((d + time.Second - 1) / time.Second)
}

// RefreshAttrs are the attributes of a leaf's root that say it is not final, for script to obey: data-refresh-after, the delay in whole seconds. A leaf
// that is final has none.
func RefreshAttrs(ctx context.Context) templ.Attributes {
	if n := refreshIn(ctx); n > 0 {
		return templ.Attributes{"data-refresh-after": strconv.Itoa(n)}
	}
	return nil
}

// RefreshNote says to the reader that the leaf drawn with ctx is not final: that it is updating, with script, and when to reload, without. A leaf
// that is final says nothing.
templ RefreshNote(ctx context.Context) {
	if n := refreshIn(ctx); n > 0 {
		<span class="refresh-note">
			<span class="refresh-js" data-refresh-state>Updating…</span>
			<button class="refresh-pause refresh-js" type="button" aria-pressed="false" data-refresh-pause>Pause</button>
			<span class="refresh-nojs">Updating, reload in { strconv.Itoa(n) } s</span>
		</span>
	}
}

// Refused is what a panel says in place of "Could not load" when its Load returned a refusal: a title for the status, the
// message, and a link on, when there is one.
type Refused struct {
	Title, Desc, Label, Href string
}

templ Panel(p PanelProps) {
	<div
		class={ "panel", templ.KV("grows", p.Grows) }
		if p.Leaf != "" {
			data-leaf={ p.Leaf }
			{ RefreshAttrs(ctx)... }
		}
	>
		<div class="panel-head">
			<h2 class="panel-title">{ p.Title }</h2>
			if p.Desc != "" {
				@InfoTip(InfoTipProps{Text: p.Desc})
			}
			if p.Failed {
				@Icon(IconProps{Name: IconAlert, Class: "panel-status bad", Title: "Failed"})
			}
			if p.Leaf != "" {
				@RefreshNote(ctx)
			}
		</div>
		<div class="panel-body">
			if p.Failed {
				if p.Refused != nil {
					@EmptyState(EmptyStateProps{Icon: IconAlert, Title: p.Refused.Title, Desc: p.Refused.Desc}) {
						if p.Refused.Href != "" {
							@Button(ButtonProps{Href: p.Refused.Href, Variant: VariantGhost, Size: SizeSmall}) {
								{ p.Refused.Label }
							}
						}
					}
				} else {
					@EmptyState(EmptyStateProps{
						Icon:  IconAlert,
						Title: "Could not load",
						Desc:  "The cause was logged on the server.",
					}) {
						if p.Retry != "" {
							@Button(ButtonProps{Href: p.Retry, Variant: VariantGhost, Size: SizeSmall, Attrs: templ.Attributes{"data-in-place": true}}) {
								Try again
							}
						}
					}
				}
			} else {
				{ children... }
			}
		</div>
		if p.Footer != nil {
			<div class="panel-foot">
				@p.Footer
			</div>
		}
	</div>
}

// InfoTipProps is a description behind an information icon. The text appears in
// a raised popover on hover and on keyboard focus, and is the icon's accessible
// name, so it is available to assistive technology and not only to a pointer.
//
// Lines is a list in the popover in place of Text, each an item; the icon's
// accessible name is the lines, after Text if there is one.
//
// Help is what the thing is for, in its own section above the rest, under the heading "Help:".
type InfoTipProps struct {
	// ID is the id of the popover's text, for a control that it describes to refer to ("" for none).
	ID    string
	Text  string
	Lines []string
	Help  string
}

func (p InfoTipProps) name() string {
	name := p.Text
	if len(p.Lines) > 0 {
		name = strings.TrimSpace(p.Text + " " + strings.Join(p.Lines, "; "))
	}
	if p.Help != "" {
		return strings.TrimSpace("Help: " + p.Help + " " + name)
	}
	return name
}

templ InfoTip(p InfoTipProps) {
	<span class="tip" tabindex="0" role="note" aria-label={ p.name() }>
		@Icon(IconProps{Name: IconInfo, Class: "info"})
		<span
			class="tip-body"
			aria-hidden="true"
			if p.ID != "" {
				id={ p.ID }
			}
		>
			if p.Help != "" {
				<span class="tip-title">Help:</span>
				<span class="tip-text">{ p.Help }</span>
			}
			if len(p.Lines) == 0 {
				{ p.Text }
			} else {
				<span class="tip-title">{ p.Text }</span>
				for _, line := range p.Lines {
					<span class="tip-item">{ line }</span>
				}
			}
		</span>
	</span>
}
