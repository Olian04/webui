package components

// IconName is a Font Awesome Free solid icon, by its name without the class prefix:
// "house" is the house icon. The renderer draws it with the icon font, which has a
// file for each group of icons: the ones below are what the design itself uses, and
// they are in icons_core.txt, which every page links. A name that is not there
// is drawn only when an app names it, in a page's Nav or an external link.
type IconName string

const (
	IconNone     IconName = ""
	IconInfo     IconName = "circle-info"
	IconAlert    IconName = "circle-exclamation"
	IconLock     IconName = "lock"
	IconSearch   IconName = "magnifying-glass"
	IconRefresh  IconName = "rotate-right"
	IconFilter   IconName = "filter"
	IconChevron  IconName = "chevron-down"
	IconGear     IconName = "gear"
	IconClose    IconName = "xmark"
	IconExternal IconName = "arrow-up-right-from-square"
	IconArrowUp   IconName = "arrow-up"
	IconArrowDown IconName = "arrow-down"
	IconSun      IconName = "sun"
	IconMoon     IconName = "moon"
	IconSortAsc  IconName = "chevron-up"
	IconSortDesc IconName = "chevron-down"
	IconMenu     IconName = "bars"
	IconMore     IconName = "ellipsis"
)

// IconProps describes one icon. Icons are decorative by default: give Title a
// value only when the icon is the sole carrier of meaning, in which case it
// becomes the accessible name and the hover tooltip.
type IconProps struct {
	Name  IconName
	Class string
	Title string
}

templ Icon(p IconProps) {
	if p.Name != IconNone {
		<i
			class={ "fa-solid", "fa-" + string(p.Name), templ.KV(p.Class, p.Class != "") }
			if p.Title == "" {
				aria-hidden="true"
			} else {
				role="img"
				aria-label={ p.Title }
				title={ p.Title }
			}
		></i>
	}
}
