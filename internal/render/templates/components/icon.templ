package components

// IconName selects one of the icons this design language ships. The set is
// closed on purpose: an icon that is not here is a picture the design has no
// meaning for, and adding one is a design decision rather than a call site's.
type IconName string

const (
	IconNone     IconName = ""
	IconInfo     IconName = "info"
	IconAlert    IconName = "alert"
	IconOK       IconName = "ok"
	IconLock     IconName = "lock"
	IconFlag     IconName = "flag"
	IconSearch   IconName = "search"
	IconRefresh  IconName = "refresh"
	IconFilter   IconName = "filter"
	IconChevron  IconName = "chevron"
	IconDevice   IconName = "device"
	IconBell     IconName = "bell"
	IconGear     IconName = "gear"
	IconHelp     IconName = "help"
	IconSortAsc  IconName = "sort-asc"
	IconSortDesc IconName = "sort-desc"
)

// iconPath is a switch rather than a map so the set stays immutable and needs
// no package-level state.
func iconPath(n IconName) string {
	switch n {
	case IconInfo:
		return `<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>`
	case IconAlert:
		return `<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>`
	case IconOK:
		return `<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>`
	case IconLock:
		return `<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>`
	case IconFlag:
		return `<path d="M5 21V4h13l-2.5 4L18 12H5"/>`
	case IconSearch:
		return `<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.4-3.4"/>`
	case IconRefresh:
		return `<path d="M21 12a9 9 0 1 1-2.6-6.4M21 3v6h-6"/>`
	case IconFilter:
		return `<path d="M3 5h18l-7 8v6l-4 2v-8z"/>`
	case IconChevron:
		return `<path d="M6 9l6 6 6-6"/>`
	case IconDevice:
		return `<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>`
	case IconBell:
		return `<path d="M12 3a6 6 0 0 0-6 6c0 5-2 6-2 6h16s-2-1-2-6a6 6 0 0 0-6-6zM10.3 20a2 2 0 0 0 3.4 0"/>`
	case IconGear:
		return `<circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M4.2 7.5l1.7 1M18.1 15.5l1.7 1M4.2 16.5l1.7-1M18.1 8.5l1.7-1"/>`
	case IconHelp:
		return `<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.2 2.4c-.7.2-.7.8-.7 1.3M12 17h.01"/>`
	case IconSortAsc:
		return `<path d="M6 15l6-6 6 6"/>`
	case IconSortDesc:
		return `<path d="M6 9l6 6 6-6"/>`
	case IconNone:
		return ""
	}
	return ""
}

// IconProps describes one icon. Icons are decorative by default: give Title a
// value only when the icon is the sole carrier of meaning, in which case it
// becomes the accessible name and, in a <svg>, the hover tooltip.
type IconProps struct {
	Name  IconName
	Class string
	Title string
	Attrs templ.Attributes
}

templ Icon(p IconProps) {
	if p.Name != IconNone {
		<svg
			class={ p.Class }
			viewBox="0 0 24 24"
			if p.Title == "" {
				aria-hidden="true"
			}
			{ p.Attrs... }
		>
			if p.Title != "" {
				<title>{ p.Title }</title>
			}
			@templ.Raw(iconPath(p.Name))
		</svg>
	}
}
