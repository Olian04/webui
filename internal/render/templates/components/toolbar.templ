package components

// The toolbar is a page's arguments, rendered as controls. A page argument is
// a named value that lives in the URL, survives reload and sharing, and
// reloads whatever reads it — so the bar is generated from the argument list
// and nothing in it is placed by hand.

type ToolBarProps struct {
	Attrs templ.Attributes
}

templ ToolBar(p ToolBarProps) {
	<div class="toolbar" data-toolbar { p.Attrs... }>
		{ children... }
	</div>
}

// ToolBarRight holds the controls that are not arguments: refresh, clear.
templ ToolBarRight() {
	<div class="tb-right">
		{ children... }
	</div>
}

// ToolBarMessage replaces the pills when there is nothing to show. A page that
// declares no arguments says so rather than rendering an empty strip: absence
// is the configuration, and it should be legible.
templ ToolBarMessage(text string) {
	<span class="noargs">{ text }</span>
}

// VariableProps is one argument pill: a label segment joined to a control
// segment. The control is { children... } — an Input, a Select, or whatever
// the argument's kind calls for.
//
// ClearHref is the address with this argument removed. Non-empty means the
// argument is set, so the × is shown; there is no separate Set bool.
type VariableProps struct {
	Label     string
	Desc      string
	ClearHref string
	Attrs     templ.Attributes
}

templ Variable(p VariableProps) {
	<div class="var" { p.Attrs... }>
		<span class="var-label">
			{ p.Label }
			if p.Desc != "" {
				@Icon(IconProps{Name: IconInfo, Title: p.Desc})
			}
		</span>
		<div class="var-ctl">
			{ children... }
			if p.ClearHref != "" {
				<a class="var-x" href={ p.ClearHref } aria-label={ "Clear " + p.Label }>&times;</a>
			}
		</div>
	</div>
}

// ToolBarButton is the squared-off control used in the toolbar, distinct from
// Button because it belongs to the chrome rather than to the content.
type ToolBarButtonProps struct {
	Label string
	Href  string
	Icon  IconName
	Split SplitSide
	Attrs templ.Attributes
}

// SplitSide joins two toolbar buttons into one control.
type SplitSide string

const (
	SplitNone  SplitSide = ""
	SplitLeft  SplitSide = "split-l"
	SplitRight SplitSide = "split-r"
)

templ ToolBarButton(p ToolBarButtonProps) {
	if p.Href != "" {
		<a class={ "tb-btn", string(p.Split) } href={ p.Href } { p.Attrs... }>
			@Icon(IconProps{Name: p.Icon})
			{ p.Label }
		</a>
	} else {
		<button class={ "tb-btn", string(p.Split) } type="button" { p.Attrs... }>
			@Icon(IconProps{Name: p.Icon})
			{ p.Label }
		</button>
	}
}
