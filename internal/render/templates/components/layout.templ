package components

// Layouts arrange and nothing else. They never load, never guard, and never
// constrain what their children are about — a form for one model beside a
// table of another is the ordinary case.

// StackProps is a column of panels, 8px apart.
type StackProps struct {
	Attrs templ.Attributes
}

templ Stack(p StackProps) {
	<div class="stack" { p.Attrs... }>
		{ children... }
	</div>
}

// SplitProps is two columns, top-aligned so unequal heights do not stretch.
// Weighted makes the first column 1.6 times the second.
type SplitProps struct {
	Weighted bool
	Attrs    templ.Attributes
}

templ Split(p SplitProps) {
	<div class={ "split", templ.KV("w64", p.Weighted) } { p.Attrs... }>
		{ children... }
	</div>
}

// Tab is one entry in a tab strip. Href is required: a tab is a link carrying
// an argument, which is why a tab can be shared, survives a reload, and works
// with scripting disabled.
type Tab struct {
	Label  string
	Href   string
	Active bool
}

type TabsProps struct {
	Tabs  []Tab
	Label string // accessible name for the strip, e.g. "Device views"
	Attrs templ.Attributes
}

templ Tabs(p TabsProps) {
	<nav class="tabs" aria-label={ p.Label } { p.Attrs... }>
		for _, t := range p.Tabs {
			<a
				class={ "tab", templ.KV("active", t.Active) }
				href={ t.Href }
				if t.Active {
					aria-current="page"
				}
			>{ t.Label }</a>
		}
	</nav>
}

// SectionProps is a collapsible row of panels: the mechanism that makes a long
// page scannable without pagination.
type SectionProps struct {
	ID        string
	Label     string
	Count     string
	Collapsed bool
	Attrs     templ.Attributes
}

templ Section(p SectionProps) {
	<div
		class={ "rowhead", templ.KV("closed", p.Collapsed) }
		data-row={ p.ID }
		role="button"
		tabindex="0"
		aria-expanded={ boolAttr(!p.Collapsed) }
		aria-controls={ p.ID }
		{ p.Attrs... }
	>
		@Icon(IconProps{Name: IconChevron})
		{ p.Label }
		if p.Count != "" {
			<span class="cnt">{ p.Count }</span>
		}
	</div>
	<div id={ p.ID } class={ "rowbody", templ.KV("closed", p.Collapsed) } data-rowbody={ p.ID }>
		{ children... }
	</div>
}

func boolAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
