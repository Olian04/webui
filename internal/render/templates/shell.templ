package templates

// DocumentProps is the whole page.
//
// Early is rendered before the stylesheets: what the browser should know before it
// has any, so the first thing it paints is not its default white.
type DocumentProps struct {
	Title       string
	Early       templ.Component
	Stylesheets []string
	Scripts     []string
	Head        templ.Component

	// Theme is the theme that the app is pinned to, "dark" or "light": the document says so, and the script that keeps the viewer's choice
	// leaves it alone. Empty, the document names none, and the stylesheet follows the viewer's system until they choose.
	Theme string
}

templ Document(p DocumentProps) {
	<!DOCTYPE html>
	<html
		lang="en"
		if p.Theme != "" {
			data-theme={ p.Theme }
			data-theme-pinned
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
			if p.Early != nil {
				@p.Early
			}
			<title>{ p.Title }</title>
			for _, href := range p.Stylesheets {
				<link rel="stylesheet" href={ href }/>
			}
			for _, src := range p.Scripts {
				<script src={ src } defer></script>
			}
			if p.Head != nil {
				@p.Head
			}
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

// AppShellProps is the four fixed regions. Only the content region scrolls,
// and each region is a slot because the shell has no opinion about what goes
// in them — it owns the geometry, nothing else.
type AppShellProps struct {
	Sidebar templ.Component
	TopBar  templ.Component
	Status  templ.Component
	Toasts  templ.Component

	// Streaming is a page that is sent as it is built: see [PageProps].
	Streaming  bool
	StatusLive templ.Component
	StatusLate templ.Component

	// Heading is the page's name, which the page has no heading for of its own (its panels are h2): it is the one h1, for a reader
	// who goes by headings, and is not drawn, since the breadcrumb is where the eye finds it.
	Heading string
}

templ AppShell(p AppShellProps) {
	<a class="skip" href="#main">Skip to content</a>
	if p.Streaming && p.StatusLive != nil {
		@p.StatusLive
	}
	<div class="app">
		if p.Sidebar != nil {
			@p.Sidebar
		}
		<div class="main">
			if p.TopBar != nil {
				@p.TopBar
			}
			<main id="main" tabindex="-1" class={ "scroll", templ.KV("scroll-arriving", p.Streaming) }>
				if p.Heading != "" {
					<h1 class="sr-only">{ p.Heading }</h1>
				}
				if p.Streaming {
					<div class="arriving" role="status" aria-label="The rest of the page is loading">
						<span class="spin" aria-hidden="true"></span>
					</div>
				}
				{ children... }
				if p.Streaming {
					<i class="arrived" hidden></i>
				}
			</main>
		</div>
	</div>
	if p.Streaming {
		if p.StatusLate != nil {
			@p.StatusLate
		}
	} else if p.Status != nil {
		@p.Status
	}
	// What script changes without a navigation (a panel that is replaced, a search that answers) is said here, in words, once, to a reader whom a changed
	// panel tells nothing. It is empty when the page is drawn, which is what makes what is put in it a change that is announced.
	<div class="sr-only" role="status" aria-live="polite" data-announce></div>
	if p.Toasts != nil {
		@p.Toasts
	}
}
