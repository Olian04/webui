package templates

// DocumentProps is the whole page.
//
// Early is rendered before the stylesheets: what the browser should know before it
// has any, so the first thing it paints is not its default white.
type DocumentProps struct {
	Title       string
	Early       templ.Component
	Stylesheets []string
	Scripts     []string
	Head        templ.Component
}

templ Document(p DocumentProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
			if p.Early != nil {
				@p.Early
			}
			<title>{ p.Title }</title>
			for _, href := range p.Stylesheets {
				<link rel="stylesheet" href={ href }/>
			}
			for _, src := range p.Scripts {
				<script src={ src } defer></script>
			}
			if p.Head != nil {
				@p.Head
			}
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

// AppShellProps is the four fixed regions. Only the content region scrolls,
// and each region is a slot because the shell has no opinion about what goes
// in them — it owns the geometry and the view-transition names, nothing else.
type AppShellProps struct {
	Sidebar templ.Component
	TopBar  templ.Component
	Status  templ.Component
	Toasts  templ.Component

	// Streaming is a page that is sent as it is built: see [PageProps].
	Streaming  bool
	StatusLive templ.Component
	StatusLate templ.Component
}

templ AppShell(p AppShellProps) {
	if p.Streaming && p.StatusLive != nil {
		@p.StatusLive
	}
	<div class="app">
		if p.Sidebar != nil {
			@p.Sidebar
		}
		<div class="main">
			if p.TopBar != nil {
				@p.TopBar
			}
			<main class={ "scroll", templ.KV("scroll-arriving", p.Streaming) }>
				if p.Streaming {
					<div class="arriving" role="status" aria-label="The rest of the page is loading">
						<span class="spin" aria-hidden="true"></span>
					</div>
				}
				{ children... }
				if p.Streaming {
					<i class="arrived" hidden></i>
				}
			</main>
		</div>
	</div>
	if p.Streaming {
		if p.StatusLate != nil {
			@p.StatusLate
		}
	} else if p.Status != nil {
		@p.Status
	}
	if p.Toasts != nil {
		@p.Toasts
	}
}
