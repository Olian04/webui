// Package example rebuilds pages from docs/mock using only the component
// library, to prove the library covers the design. It is not part of the
// library and nothing outside this directory may import it.
package example

import (
	"fmt"

	c "github.com/Olian04/webui/internal/render/templates/components"
	t "github.com/Olian04/webui/internal/render/templates"
)

type Device struct {
	ID     string
	IP     string
	Status string
	Site   string
	Count  int
	Rate   float64
}

// Args is the page's argument struct. Everything in it lives in the URL.
type Args struct {
	Site, Status, Q, Sort, Dir string
	Offset                     int
}

type DevicesData struct {
	Args     Args
	Rows     []Device
	Total    int
	MaxRate  float64
	Prev     string
	Next     string
	Href     func(patch Args) string
	SortHref func(key string) string
	SortDir  func(key string) c.SortDir
	ClearAll string
}

// ---------------------------------------------------------------- the glue
templ Shell(active string, crumbs []c.Crumb, toolbar templ.Component) {
	@t.Page(t.PageProps{
		Title:       "Devices — webui",
		Theme:       t.ThemeDark,
		Role:        "editor",
		Stylesheets: []string{"/assets/app.css"},
		Sidebar: sidebar(active),
		TopBar:  topbar(crumbs),
		ToolBar: toolbar,
		Status:  c.StatusBar(c.StatusBarProps{Method: "GET", URL: "/admin/device"}),
	})
}

templ sidebar(active string) {
	@c.Sidebar(c.SidebarProps{Brand: "Collector", Footer: sidebarFooter()}) {
		@c.NavSection("Platform")
		@c.NavItem(c.NavItemProps{Label: "Devices", Href: "/index.html", Icon: c.IconDevice, Count: "37", Active: active == "devices"})
		@c.NavItem(c.NavItemProps{Label: "Alerts", Href: "/alert.html", Icon: c.IconBell, Count: "11", Active: active == "alerts"})
		@c.NavSection("Configuration")
		@c.NavGroup(c.NavGroupProps{ID: "settings", Label: "Settings", Icon: c.IconGear, Open: active == "ingest"}) {
			@c.NavItem(c.NavItemProps{Label: "Ingest", Href: "/settings.html", Active: active == "ingest"})
			@c.NavItem(c.NavItemProps{Label: "Retention", Href: "/retention.html", Active: active == "retention"})
		}
	}
}

templ sidebarFooter() {
	@c.SidebarFooter() {
		@c.SidebarRow("Role: editor") {
			@c.Switch(c.SwitchProps{ID: "role", Label: "Editor role", Checked: true})
		}
		@c.SidebarRow("Panel refresh") {
			@c.Switch(c.SwitchProps{ID: "leaf", Label: "Panel refresh", Checked: true})
		}
		@c.SidebarRow("Light theme") {
			@c.Switch(c.SwitchProps{ID: "theme", Label: "Light theme"})
		}
	}
}

templ topbar(crumbs []c.Crumb) {
	@c.TopBar(c.TopBarProps{Crumbs: crumbs}) {
		@c.Search(c.SearchProps{Placeholder: "Search…", Shortcut: "⌘K"})
		@c.IconButton(c.IconButtonProps{Icon: c.IconHelp, Title: "About this app", Href: "/README.txt"})
		@c.Avatar("OL", "Oliver")
	}
}

// ------------------------------------------------------- the toolbar is Args
templ devicesToolbar(d DevicesData) {
	@c.ToolBar(c.ToolBarProps{}) {
		@c.Variable(c.VariableProps{Label: "Site", Desc: "Which site to show", ClearHref: clearIf(d, "site")}) {
			@c.Select(c.SelectProps{Name: "site", Value: d.Args.Site, Attrs: templ.Attributes{"data-var": "site"}, Options: []c.Option{
				{Value: "", Label: "All"}, {Value: "Stockholm", Label: "Stockholm"},
				{Value: "Malmö", Label: "Malmö"}, {Value: "Göteborg", Label: "Göteborg"},
			}})
		}
		@c.Variable(c.VariableProps{Label: "Status", Desc: "Reporting state", ClearHref: clearIf(d, "status")}) {
			@c.Select(c.SelectProps{Name: "status", Value: d.Args.Status, Attrs: templ.Attributes{"data-var": "status"}, Options: []c.Option{
				{Value: "", Label: "All"}, {Value: "healthy", Label: "healthy"},
				{Value: "degraded", Label: "degraded"}, {Value: "quiet", Label: "quiet"},
			}})
		}
		@c.Variable(c.VariableProps{Label: "Filter", Desc: "Match id, ip or site", ClearHref: clearIf(d, "q")}) {
			@c.Input(c.InputProps{Name: "q", Value: d.Args.Q, Placeholder: "id, ip or site…", Attrs: templ.Attributes{"data-var": "q"}})
		}
		@c.ToolBarRight() {
			if d.ClearAll != "" {
				@c.ToolBarButton(c.ToolBarButtonProps{Label: "Clear all", Href: d.ClearAll})
			}
			@c.ToolBarButton(c.ToolBarButtonProps{Label: "Refresh", Icon: c.IconRefresh, Href: d.Href(d.Args), Split: c.SplitLeft})
			@c.ToolBarButton(c.ToolBarButtonProps{Icon: c.IconChevron, Split: c.SplitRight, Attrs: templ.Attributes{"data-act": "refresh-menu"}})
		}
	}
}

func clearIf(d DevicesData, name string) string {
	a := d.Args
	switch name {
	case "site":
		if a.Site == "" {
			return ""
		}
		a.Site = ""
	case "status":
		if a.Status == "" {
			return ""
		}
		a.Status = ""
	case "q":
		if a.Q == "" {
			return ""
		}
		a.Q = ""
	}
	a.Offset = 0
	return d.Href(a)
}

// ------------------------------------------------------------- the page
templ DevicesPage(d DevicesData) {
	@t.Page(t.PageProps{
		Title:       "Devices — webui",
		Theme:       t.ThemeDark,
		Role:        "editor",
		Stylesheets: []string{"/assets/app.css"},
		Sidebar: sidebar("devices"),
		TopBar:  topbar([]c.Crumb{{Label: "Collector", Href: "/index.html"}, {Label: "Devices"}}),
		ToolBar: devicesToolbar(d),
		Status:  c.StatusBar(c.StatusBarProps{Method: "GET", URL: "/admin/device"}),
	}) {
		@c.Section(c.SectionProps{ID: "overview", Label: "Overview", Count: fmt.Sprintf("%d devices", d.Total)}) {
			@c.Stack(c.StackProps{}) {
				@devicesTable(d)
			}
		}
		@c.Note(c.NoteProps{}) {
			<p>
				<b>The toolbar is the page's argument struct.</b>
				Every pill is one declared argument; nothing in the bar is placed by hand.
			</p>
			<p>
				<b>Sort headers, the pager and every row are real links.</b>
				This page is assembled from the component library with nothing but glue.
			</p>
		}
	}
}

templ devicesTable(d DevicesData) {
	@c.Panel(c.PanelProps{
		Title:  "Devices",
		Desc:   "One Table leaf. Sort, page and row links are all URLs.",
		Status: c.ToneOK,
		Leaf:   "devices",
		Footer: c.Pager(c.PagerProps{Offset: d.Args.Offset, Size: 10, Total: d.Total, PrevHref: d.Prev, NextHref: d.Next}),
	}) {
		@c.Table(c.TableProps{Label: "Devices"}) {
			@c.TableHead() {
				@column(d, "id", "ID", c.AlignStart, "")
				@column(d, "ip", "IP", c.AlignStart, "")
				@column(d, "status", "Status", c.AlignStart, "110px")
				@column(d, "site", "Site", c.AlignStart, "")
				@column(d, "count", "Occurrences", c.AlignEnd, "")
				@column(d, "rate", "Rate / s", c.AlignEnd, "")
			}
			@c.TableBody() {
				if len(d.Rows) == 0 {
					@c.Row(c.RowProps{}) {
						@c.Cell(c.CellProps{ColSpan: 6}) {
							@c.EmptyState(c.EmptyStateProps{
								Icon:  c.IconSearch,
								Title: "No devices match the current arguments",
								Desc:  "Clear them in the toolbar to see all 37.",
							})
						}
					}
				}
				for _, row := range d.Rows {
					@deviceRow(row, d.MaxRate)
				}
			}
		}
	}
}

templ column(d DevicesData, key string, label string, align c.Align, width string) {
	@c.Column(c.ColumnProps{
		Label: label, Align: align, Width: width,
		SortHref: d.SortHref(key), SortDir: d.SortDir(key),
	})
}

templ deviceRow(row Device, maxRate float64) {
	@c.Row(c.RowProps{Href: "/device/" + row.ID + ".html"}) {
		@c.Cell(c.CellProps{Mono: true, Dim: true}) {
			@c.RowLink("/device/" + row.ID + ".html") {
				{ row.ID }
			}
		}
		@c.Cell(c.CellProps{Mono: true}) {
			{ row.IP }
		}
		@c.Cell(c.CellProps{}) {
			@c.Badge(c.BadgeProps{Tone: statusTone(row.Status), Dot: true}) {
				{ row.Status }
			}
		}
		@c.Cell(c.CellProps{Dim: true}) {
			{ row.Site }
		}
		@c.Cell(c.CellProps{Align: c.AlignEnd}) {
			{ fmt.Sprintf("%d", row.Count) }
		}
		@c.Cell(c.CellProps{Align: c.AlignEnd}) {
			@c.Gauge(c.GaugeProps{Value: row.Rate, Max: maxRate, Text: fmt.Sprintf("%.2f", row.Rate)})
		}
	}
}

func statusTone(s string) c.Tone {
	switch s {
	case "healthy":
		return c.ToneOK
	case "degraded":
		return c.ToneWarning
	}
	return c.ToneNeutral
}
